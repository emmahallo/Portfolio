---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Stern-Optionen">
<style>
  .page {
    font-family: sans-serif;
  }

  .section {
    padding: 4rem 2rem;
  }

  .section--light { background: #f5f4f0; }
  .section--dark  { background: #2c302d; }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 2.5rem 2rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .cell-label {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: center;
    opacity: 0.55;
  }

  .section--dark .cell-label { color: #fff; }
  .section--light .cell-label { color: #2c302d; }

  .section-title {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
    margin-bottom: 2.5rem;
    opacity: 0.4;
  }
  .section--dark .section-title { color: #fff; }

  /* ── Basis-Stern-Form ── */
  .stern {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
  }

  /* A: Sage-Grün ausgefüllt (wie aktuell) */
  .a { background: #809582; -webkit-mask: url('/stern-3.svg') center / contain no-repeat; mask: url('/stern-3.svg') center / contain no-repeat; animation: spin 14s linear infinite; }

  /* B: Weiß ausgefüllt */
  .b { background: #ffffff; -webkit-mask: url('/stern-3.svg') center / contain no-repeat; mask: url('/stern-3.svg') center / contain no-repeat; animation: spin 14s linear infinite; }

  /* C: Dunkel / Ink */
  .c { background: #2c302d; -webkit-mask: url('/stern-3.svg') center / contain no-repeat; mask: url('/stern-3.svg') center / contain no-repeat; animation: spin 14s linear infinite; }

  /* D: SVG direkt mit Stroke (kein Fill) */
  .d svg { width: 64px; height: 64px; fill: none; stroke: #809582; stroke-width: 18; animation: spin 14s linear infinite; }
  .d-white svg { stroke: #ffffff; }
  .d-dark svg { stroke: #2c302d; }

  /* E: Ausgefüllt + Glow */
  .e { background: #809582; -webkit-mask: url('/stern-3.svg') center / contain no-repeat; mask: url('/stern-3.svg') center / contain no-repeat; animation: spin 14s linear infinite; filter: drop-shadow(0 0 8px rgba(128,149,130,0.8)); }
  .e-white { background: #ffffff; filter: drop-shadow(0 0 10px rgba(255,255,255,0.9)); }
  .e-gold { background: #c9a84c; filter: drop-shadow(0 0 8px rgba(201,168,76,0.7)); }

  /* F: Stroke + Glow */
  .f svg { width: 64px; height: 64px; fill: none; stroke: #ffffff; stroke-width: 18; filter: drop-shadow(0 0 6px rgba(255,255,255,0.8)); animation: spin 14s linear infinite; }
  .f-sage svg { stroke: #809582; filter: drop-shadow(0 0 6px rgba(128,149,130,0.8)); }

  /* G: Zweifarbig – Outline + Kern */
  .g { position: relative; width: 64px; height: 64px; }
  .g-inner {
    position: absolute; inset: 0;
    -webkit-mask: url('/stern-3.svg') center / contain no-repeat;
    mask: url('/stern-3.svg') center / contain no-repeat;
    animation: spin 14s linear infinite;
  }
  .g-fill { background: #ffffff; opacity: 0.15; }
  .g-stroke svg { position: absolute; inset: 0; width: 100%; height: 100%; fill: none; stroke: #ffffff; stroke-width: 18; }

  /* H: Pulsieren statt Drehen */
  .h { background: #809582; -webkit-mask: url('/stern-3.svg') center / contain no-repeat; mask: url('/stern-3.svg') center / contain no-repeat; animation: pulse 2.5s ease-in-out infinite; }
  .h-white { background: #ffffff; }
  .h-gold { background: #c9a84c; }

  /* I: Drehen + Größe */
  .i { background: #809582; -webkit-mask: url('/stern-3.svg') center / contain no-repeat; mask: url('/stern-3.svg') center / contain no-repeat; animation: spin-grow 8s ease-in-out infinite; }
  .i-white { background: #ffffff; }

  /* J: Blinken */
  .j { background: #ffffff; -webkit-mask: url('/stern-3.svg') center / contain no-repeat; mask: url('/stern-3.svg') center / contain no-repeat; animation: blink 3s ease-in-out infinite; }
  .j-sage { background: #809582; }
  .j-gold { background: #c9a84c; }

  @keyframes spin {
    from { rotate: 0deg; }
    to   { rotate: 360deg; }
  }

  @keyframes pulse {
    0%, 100% { scale: 1;    opacity: 1; }
    50%       { scale: 1.2; opacity: 0.7; }
  }

  @keyframes spin-grow {
    0%   { rotate: 0deg;   scale: 1; }
    50%  { rotate: 180deg; scale: 1.15; }
    100% { rotate: 360deg; scale: 1; }
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.15; }
  }
</style>

