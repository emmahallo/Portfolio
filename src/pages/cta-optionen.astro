---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="CTA Rechte Seite – Optionen" description="Vorschau verschiedener Varianten für die rechte Seite der CTA-Section." robots="noindex, nofollow">
  <Header />
  <main>

    <section class="section intro">
      <div class="wrapper">
        <h1 class="intro__heading">Rechte Seite – 6 Varianten</h1>
        <p class="intro__sub">Linke Seite bleibt wie sie ist. Nur der rechte Teil wird ausgetauscht.</p>
      </div>
    </section>

    <!-- ============================================================
         Jede Variante zeigt die vollständige CTA-Zeile:
         links = aktueller Text, rechts = Variante
    ============================================================ -->

    <!-- Variante 1: Großer gestapelter Button -->
    <section class="section variant-block">
      <div class="wrapper">
        <p class="variant-label">Variante 1 · Großer Button mit Pfeil</p>
        <div class="cta-row">
          <div class="cta-left">
            <span class="eyebrow"><span class="eyebrow__dot" aria-hidden="true"></span>Kontakt</span>
            <h2 class="cta-title">Neugierig<br>geworden?</h2>
            <p class="cta-sub">Du hast ein Projekt, eine Praktikumsstelle oder einfach eine Frage? Schreib mir – ich freu mich, von dir zu hören.</p>
          </div>
          <div class="cta-right">
            <a href="mailto:emma.eichin@gmx.de" class="v1__btn">
              <span class="v1__btn-text">Schreib mir</span>
              <span class="v1__btn-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="M5 19L19 5M19 5H8M19 5V16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Variante 2: Visitenkarte -->
    <section class="section variant-block">
      <div class="wrapper">
        <p class="variant-label">Variante 2 · Visitenkarte</p>
        <div class="cta-row">
          <div class="cta-left">
            <span class="eyebrow"><span class="eyebrow__dot" aria-hidden="true"></span>Kontakt</span>
            <h2 class="cta-title">Neugierig<br>geworden?</h2>
            <p class="cta-sub">Du hast ein Projekt, eine Praktikumsstelle oder einfach eine Frage? Schreib mir – ich freu mich, von dir zu hören.</p>
          </div>
          <div class="cta-right">
            <div class="v2__card">
              <div class="v2__shadow" aria-hidden="true"></div>
              <div class="v2__front">
                <p class="v2__name">Emma Eichin</p>
                <p class="v2__role">UI/UX-Design · Mediendesign</p>
                <div class="v2__divider" aria-hidden="true"></div>
                <a href="mailto:emma.eichin@gmx.de" class="v2__link">emma.eichin@gmx.de</a>
                <a href="https://www.linkedin.com/in/emma-eichin-35b575427/" class="v2__link" target="_blank" rel="noopener noreferrer">LinkedIn →</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Variante 3: Handgeschriebene Notiz -->
    <section class="section variant-block">
      <div class="wrapper">
        <p class="variant-label">Variante 3 · Handgeschriebene Notiz</p>
        <div class="cta-row">
          <div class="cta-left">
            <span class="eyebrow"><span class="eyebrow__dot" aria-hidden="true"></span>Kontakt</span>
            <h2 class="cta-title">Neugierig<br>geworden?</h2>
            <p class="cta-sub">Du hast ein Projekt, eine Praktikumsstelle oder einfach eine Frage? Schreib mir – ich freu mich, von dir zu hören.</p>
          </div>
          <div class="cta-right">
            <a href="mailto:emma.eichin@gmx.de" class="v3__note">
              <div class="v3__shadow" aria-hidden="true"></div>
              <p class="v3__text">Schreib mir!</p>
              <p class="v3__sig">— Emma</p>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Variante 4: E-Mail groß typografisch -->
    <section class="section variant-block">
      <div class="wrapper">
        <p class="variant-label">Variante 4 · E-Mail-Adresse als Typografie</p>
        <div class="cta-row">
          <div class="cta-left">
            <span class="eyebrow"><span class="eyebrow__dot" aria-hidden="true"></span>Kontakt</span>
            <h2 class="cta-title">Neugierig<br>geworden?</h2>
            <p class="cta-sub">Du hast ein Projekt, eine Praktikumsstelle oder einfach eine Frage? Schreib mir – ich freu mich, von dir zu hören.</p>
          </div>
          <div class="cta-right">
            <a href="mailto:emma.eichin@gmx.de" class="v4__mail">
              <span class="v4__label">Mail</span>
              <span class="v4__address">emma.eichin<br>@gmx.de</span>
              <span class="v4__arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Variante 5: Stempel -->
    <section class="section variant-block">
      <div class="wrapper">
        <p class="variant-label">Variante 5 · Stempel</p>
        <div class="cta-row">
          <div class="cta-left">
            <span class="eyebrow"><span class="eyebrow__dot" aria-hidden="true"></span>Kontakt</span>
            <h2 class="cta-title">Neugierig<br>geworden?</h2>
            <p class="cta-sub">Du hast ein Projekt, eine Praktikumsstelle oder einfach eine Frage? Schreib mir – ich freu mich, von dir zu hören.</p>
          </div>
          <div class="cta-right">
            <a href="mailto:emma.eichin@gmx.de" class="v5__stamp">
              <span class="v5__inner">
                <span class="v5__top">Kontakt</span>
                <span class="v5__mid">Schreib mir</span>
                <span class="v5__bot">emma.eichin@gmx.de</span>
              </span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Variante 6: Link-Stack (E-Mail + LinkedIn) -->
    <section class="section variant-block">
      <div class="wrapper">
        <p class="variant-label">Variante 6 · Link-Stack</p>
        <div class="cta-row">
          <div class="cta-left">
            <span class="eyebrow"><span class="eyebrow__dot" aria-hidden="true"></span>Kontakt</span>
            <h2 class="cta-title">Neugierig<br>geworden?</h2>
            <p class="cta-sub">Du hast ein Projekt, eine Praktikumsstelle oder einfach eine Frage? Schreib mir – ich freu mich, von dir zu hören.</p>
          </div>
          <div class="cta-right">
            <div class="v6__stack">
              <a href="mailto:emma.eichin@gmx.de" class="v6__item">
                <span class="v6__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none"><rect x="2" y="4" width="20" height="16" rx="1" stroke="currentColor" stroke-width="1.6"/><path d="M2 7l10 7 10-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                </span>
                <span class="v6__text">
                  <span class="v6__channel">E-Mail</span>
                  <span class="v6__value">emma.eichin@gmx.de</span>
                </span>
                <span class="v6__arrow" aria-hidden="true">→</span>
              </a>
              <a href="https://www.linkedin.com/in/emma-eichin-35b575427/" class="v6__item" target="_blank" rel="noopener noreferrer">
                <span class="v6__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none"><rect x="2" y="2" width="20" height="20" rx="3" stroke="currentColor" stroke-width="1.6"/><path d="M7 10v7M7 7v.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M11 17v-4a2 2 0 0 1 4 0v4M11 10v7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                </span>
                <span class="v6__text">
                  <span class="v6__channel">LinkedIn</span>
                  <span class="v6__value">Emma Eichin</span>
                </span>
                <span class="v6__arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Variante 7: Polaroid mit Foto -->
    <section class="section variant-block">
      <div class="wrapper">
        <p class="variant-label">Variante 7 · Polaroid</p>
        <div class="cta-row">
          <div class="cta-left">
            <span class="eyebrow"><span class="eyebrow__dot" aria-hidden="true"></span>Kontakt</span>
            <h2 class="cta-title">Neugierig<br>geworden?</h2>
            <p class="cta-sub">Du hast ein Projekt, eine Praktikumsstelle oder einfach eine Frage? Schreib mir – ich freu mich, von dir zu hören.</p>
          </div>
          <div class="cta-right">
            <a href="mailto:emma.eichin@gmx.de" class="v7__polaroid">
              <div class="v7__photo">
                <img src="/images/emma.JPG" alt="Emma Eichin" />
              </div>
              <p class="v7__caption">Schreib mir!</p>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Variante 8: Ticket -->
    <section class="section variant-block">
      <div class="wrapper">
        <p class="variant-label">Variante 8 · Eintrittskarte</p>
        <div class="cta-row">
          <div class="cta-left">
            <span class="eyebrow"><span class="eyebrow__dot" aria-hidden="true"></span>Kontakt</span>
            <h2 class="cta-title">Neugierig<br>geworden?</h2>
            <p class="cta-sub">Du hast ein Projekt, eine Praktikumsstelle oder einfach eine Frage? Schreib mir – ich freu mich, von dir zu hören.</p>
          </div>
          <div class="cta-right">
            <a href="mailto:emma.eichin@gmx.de" class="v8__ticket">
              <div class="v8__left">
                <span class="v8__eyebrow">Freie Kapazität</span>
                <span class="v8__name">Emma Eichin</span>
                <span class="v8__role">UI/UX Design</span>
              </div>
              <div class="v8__tear" aria-hidden="true"></div>
              <div class="v8__right">
                <span class="v8__cta">Schreib<br>mir</span>
                <svg viewBox="0 0 24 24" fill="none" class="v8__arrow"><path d="M5 19L19 5M19 5H8M19 5V16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Variante 9: Verfügbarkeits-Status -->
    <section class="section variant-block">
      <div class="wrapper">
        <p class="variant-label">Variante 9 · Verfügbarkeits-Badge</p>
        <div class="cta-row">
          <div class="cta-left">
            <span class="eyebrow"><span class="eyebrow__dot" aria-hidden="true"></span>Kontakt</span>
            <h2 class="cta-title">Neugierig<br>geworden?</h2>
            <p class="cta-sub">Du hast ein Projekt, eine Praktikumsstelle oder einfach eine Frage? Schreib mir – ich freu mich, von dir zu hören.</p>
          </div>
          <div class="cta-right">
            <div class="v9__block">
              <div class="v9__status">
                <span class="v9__dot" aria-hidden="true"></span>
                <span>Offen für neue Projekte</span>
              </div>
              <a href="mailto:emma.eichin@gmx.de" class="v9__mail">
                emma.eichin@gmx.de
                <span class="v9__arrow" aria-hidden="true">→</span>
              </a>
              <a href="https://www.linkedin.com/in/emma-eichin-35b575427/" class="v9__secondary" target="_blank" rel="noopener noreferrer">
                oder auf LinkedIn →
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Variante 10: P.S. -->
    <section class="section variant-block">
      <div class="wrapper">
        <p class="variant-label">Variante 10 · P.S.</p>
        <div class="cta-row">
          <div class="cta-left">
            <span class="eyebrow"><span class="eyebrow__dot" aria-hidden="true"></span>Kontakt</span>
            <h2 class="cta-title">Neugierig<br>geworden?</h2>
            <p class="cta-sub">Du hast ein Projekt, eine Praktikumsstelle oder einfach eine Frage? Schreib mir – ich freu mich, von dir zu hören.</p>
          </div>
          <div class="cta-right">
            <div class="v10__wrap">
              <div class="v10__ps" aria-hidden="true">P.S.</div>
              <div class="v10__body">
                <p class="v10__text">Ich antworte meistens innerhalb eines Tages.</p>
                <a href="mailto:emma.eichin@gmx.de" class="v10__link">emma.eichin@gmx.de →</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Variante 11: Outline-Statement -->
    <section class="section variant-block">
      <div class="wrapper">
        <p class="variant-label">Variante 11 · Outline-Statement</p>
        <div class="cta-row">
          <div class="cta-left">
            <span class="eyebrow"><span class="eyebrow__dot" aria-hidden="true"></span>Kontakt</span>
            <h2 class="cta-title">Neugierig<br>geworden?</h2>
            <p class="cta-sub">Du hast ein Projekt, eine Praktikumsstelle oder einfach eine Frage? Schreib mir – ich freu mich, von dir zu hören.</p>
          </div>
          <div class="cta-right">
            <a href="mailto:emma.eichin@gmx.de" class="v11__link">
              <span class="v11__outline">Let's</span>
              <span class="v11__filled">talk.</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Variante 12: 2×2 Kacheln -->
    <section class="section variant-block">
      <div class="wrapper">
        <p class="variant-label">Variante 12 · Kachel-Grid</p>
        <div class="cta-row">
          <div class="cta-left">
            <span class="eyebrow"><span class="eyebrow__dot" aria-hidden="true"></span>Kontakt</span>
            <h2 class="cta-title">Neugierig<br>geworden?</h2>
            <p class="cta-sub">Du hast ein Projekt, eine Praktikumsstelle oder einfach eine Frage? Schreib mir – ich freu mich, von dir zu hören.</p>
          </div>
          <div class="cta-right">
            <div class="v12__grid">
              <a href="mailto:emma.eichin@gmx.de" class="v12__tile v12__tile--accent">
                <svg viewBox="0 0 24 24" fill="none"><rect x="2" y="4" width="20" height="16" rx="1" stroke="currentColor" stroke-width="1.6"/><path d="M2 7l10 7 10-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                <span>E-Mail</span>
              </a>
              <a href="https://www.linkedin.com/in/emma-eichin-35b575427/" class="v12__tile" target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" fill="none"><rect x="2" y="2" width="20" height="20" rx="3" stroke="currentColor" stroke-width="1.6"/><path d="M7 10v7M7 7v.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M11 17v-4a2 2 0 0 1 4 0v4M11 10v7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                <span>LinkedIn</span>
              </a>
              <a href="mailto:emma.eichin@gmx.de?subject=Projekt" class="v12__tile">
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 2L2 7l10 5 10-5-10-5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M2 17l10 5 10-5M2 12l10 5 10-5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                <span>Projekt</span>
              </a>
              <a href="mailto:emma.eichin@gmx.de?subject=Praktikum" class="v12__tile">
                <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="7" width="18" height="14" rx="1" stroke="currentColor" stroke-width="1.6"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                <span>Praktikum</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Variante 13: Briefumschlag -->
    <section class="section variant-block">
      <div class="wrapper">
        <p class="variant-label">Variante 13 · Briefumschlag</p>
        <div class="cta-row">
          <div class="cta-left">
            <span class="eyebrow"><span class="eyebrow__dot" aria-hidden="true"></span>Kontakt</span>
            <h2 class="cta-title">Neugierig<br>geworden?</h2>
            <p class="cta-sub">Du hast ein Projekt, eine Praktikumsstelle oder einfach eine Frage? Schreib mir – ich freu mich, von dir zu hören.</p>
          </div>
          <div class="cta-right">
            <a href="mailto:emma.eichin@gmx.de" class="v13__env">
              <!-- Innenseite der Lasche (sichtbar wenn geöffnet) -->
              <div class="v13__inner" aria-hidden="true"></div>
              <!-- Lasche – öffnet sich beim Hover -->
              <div class="v13__flap-wrap" aria-hidden="true">
                <div class="v13__face"></div>
                <div class="v13__back"></div>
              </div>
              <!-- Briefkörper -->
              <div class="v13__body">
                <p class="v13__to">An</p>
                <p class="v13__name">Emma Eichin</p>
                <p class="v13__addr">emma.eichin@gmx.de</p>
                <p class="v13__hand">Schreib mir!</p>
              </div>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Variante 14: Antwortzeit-Chip + Mail -->
    <section class="section variant-block">
      <div class="wrapper">
        <p class="variant-label">Variante 14 · Antwortzeit + Signatur</p>
        <div class="cta-row">
          <div class="cta-left">
            <span class="eyebrow"><span class="eyebrow__dot" aria-hidden="true"></span>Kontakt</span>
            <h2 class="cta-title">Neugierig<br>geworden?</h2>
            <p class="cta-sub">Du hast ein Projekt, eine Praktikumsstelle oder einfach eine Frage? Schreib mir – ich freu mich, von dir zu hören.</p>
          </div>
          <div class="cta-right">
            <div class="v14__block">
              <p class="v14__sig">— Emma</p>
              <div class="v14__chips">
                <span class="v14__chip">antwortet in ~24h</span>
                <span class="v14__chip v14__chip--dot">
                  <span class="v14__pulse" aria-hidden="true"></span>verfügbar
                </span>
              </div>
              <a href="mailto:emma.eichin@gmx.de" class="btn btn--primary">Nachricht schreiben</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Aktuell: Kreis (Referenz) -->
    <section class="section variant-block variant-block--reference">
      <div class="wrapper">
        <p class="variant-label variant-label--reference">Aktuell · Rotierender Kreis (zum Vergleich)</p>
        <div class="cta-row">
          <div class="cta-left">
            <span class="eyebrow"><span class="eyebrow__dot" aria-hidden="true"></span>Kontakt</span>
            <h2 class="cta-title">Neugierig<br>geworden?</h2>
            <p class="cta-sub">Du hast ein Projekt, eine Praktikumsstelle oder einfach eine Frage? Schreib mir – ich freu mich, von dir zu hören.</p>
          </div>
          <div class="cta-right">
            <a class="vref__circle" href="mailto:emma.eichin@gmx.de" aria-label="E-Mail an Emma schreiben">
              <svg class="vref__ring" viewBox="0 0 200 200" aria-hidden="true">
                <defs><path id="ref-ring" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"/></defs>
                <text><textPath href="#ref-ring" startOffset="0">Schreib mir · Schreib mir · Schreib mir ·</textPath></text>
              </svg>
              <span class="vref__core" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="34" height="34"><path d="M5 19L19 5M19 5H8M19 5V16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</BaseLayout>

<style>
  /* ---- Seiten-Intro ---- */
  .intro__heading {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: var(--color-ink);
    margin: 0 0 0.5rem;
  }
  .intro__sub {
    color: var(--color-ink);
    font-weight: 300;
    font-size: 1.05rem;
    max-width: 52ch;
    margin: 0;
  }

  /* ---- Raster für jede Variante ---- */
  .variant-block {
    border-top: 1px dashed var(--color-border);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }
  .variant-block--reference {
    background: #f9faf8;
  }

  .variant-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-sage-dark);
    margin: 0 0 2rem;
    font-weight: 700;
  }
  .variant-label--reference {
    color: var(--color-ink);
  }

  /* ---- Linke Seite (immer gleich) ---- */
  .cta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .cta-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    min-width: 0;
    flex: 1;
    max-width: 640px;
  }

  .cta-title {
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--color-ink);
    font-size: clamp(2.6rem, 8.5vw, 8.5rem);
    line-height: 0.92;
    letter-spacing: 0.03em;
    margin: 0;
  }

  .cta-sub {
    font-weight: 300;
    font-size: clamp(1.05rem, 1.2vw, 1.25rem);
    color: var(--color-ink);
    max-width: 46ch;
    margin: 0;
  }

  .cta-right {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 760px) {
    .cta-row {
      flex-direction: column;
      align-items: flex-start;
    }
    .cta-right {
      align-self: flex-end;
    }
  }

  /* ============ Variante 1 · Großer Button ============ */
  .v1__btn {
    display: inline-flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem 2rem;
    border: 1px solid var(--color-sage);
    background: #ffffff;
    color: var(--color-ink);
    text-decoration: none;
    isolation: isolate;
    position: relative;
    transition: background 0.35s ease, color 0.35s ease, transform 0.35s ease;
  }
  .v1__btn::before {
    content: '';
    position: absolute;
    top: 10px; left: -7px; right: 14px; bottom: -7px;
    background: var(--color-sage-tint);
    z-index: -1;
    transition: transform 0.35s ease;
  }
  .v1__btn:hover {
    background: var(--color-sage);
    color: #ffffff;
    transform: translateY(-2px);
  }
  .v1__btn:hover::before { transform: translate(-3px, 3px); }
  .v1__btn-text {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: 0.06em;
    font-weight: 400;
    line-height: 1;
  }
  .v1__btn-arrow svg {
    width: clamp(28px, 3.5vw, 42px);
    height: clamp(28px, 3.5vw, 42px);
    transition: transform 0.35s ease;
  }
  .v1__btn:hover .v1__btn-arrow svg { transform: rotate(45deg); }

  /* ============ Variante 2 · Visitenkarte ============ */
  .v2__card {
    position: relative;
    isolation: isolate;
    width: clamp(260px, 30vw, 340px);
  }
  .v2__shadow {
    position: absolute;
    inset: 10px -8px -8px 8px;
    background: var(--color-sage-tint);
    z-index: -1;
  }
  .v2__front {
    position: relative;
    background: #ffffff;
    border: 1px solid var(--color-sage);
    padding: 1.75rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .v2__name {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    letter-spacing: 0.05em;
    color: var(--color-ink);
    margin: 0;
    font-weight: 400;
    line-height: 1.1;
  }
  .v2__role {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-sage-dark);
    font-weight: 700;
    margin: 0 0 0.25rem;
  }
  .v2__divider {
    width: 2rem;
    height: 1px;
    background: var(--color-sage);
    margin: 0.5rem 0;
  }
  .v2__link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
    padding-bottom: 1px;
    border-bottom: 1px solid transparent;
    display: inline-block;
    width: fit-content;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .v2__link:hover {
    color: var(--color-sage-dark);
    border-bottom-color: var(--color-sage-dark);
  }

  /* ============ Variante 3 · Handnotiz ============ */
  .v3__note {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 2rem 2.25rem 1.75rem;
    background: #ffffff;
    border: 1px solid var(--color-sage);
    text-decoration: none;
    isolation: isolate;
    transform: rotate(-2.5deg);
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    width: clamp(220px, 28vw, 300px);
  }
  .v3__note:hover { transform: rotate(0deg) translateY(-4px); }
  .v3__shadow {
    position: absolute;
    inset: 10px -7px -7px 7px;
    background: var(--color-sage-tint);
    z-index: -1;
  }
  .v3__text {
    font-family: 'Reenie Beanie', cursive;
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    line-height: 1;
    color: var(--color-ink);
    margin: 0;
  }
  .v3__sig {
    font-family: 'Reenie Beanie', cursive;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    line-height: 1;
    color: var(--color-sage-dark);
    margin: 0.5rem 0 0;
    transform: rotate(-1.5deg);
    transform-origin: left;
  }

  /* ============ Variante 4 · E-Mail Typografie ============ */
  .v4__mail {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    text-decoration: none;
    border-bottom: 1px solid var(--color-sage);
    padding-bottom: 1.25rem;
    transition: border-color 0.3s ease;
  }
  .v4__mail:hover { border-bottom-color: var(--color-ink); }
  .v4__label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 700;
    color: var(--color-sage-dark);
  }
  .v4__address {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: 0.04em;
    color: var(--color-ink);
    font-weight: 400;
    transition: color 0.3s ease;
  }
  .v4__mail:hover .v4__address { color: var(--color-sage-dark); }
  .v4__arrow {
    font-size: 1.5rem;
    color: var(--color-sage-dark);
    line-height: 1;
    transition: transform 0.3s ease;
  }
  .v4__mail:hover .v4__arrow { transform: translateX(5px); }

  /* ============ Variante 5 · Stempel ============ */
  .v5__stamp {
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(170px, 18vw, 220px);
    aspect-ratio: 1;
    border: 3px solid var(--color-sage);
    border-radius: 50%;
    text-decoration: none;
    position: relative;
    transition: background 0.35s ease, transform 0.35s ease;
  }
  .v5__stamp::before {
    content: '';
    position: absolute;
    inset: 6px;
    border: 1px solid var(--color-sage);
    border-radius: 50%;
    transition: border-color 0.35s ease;
  }
  .v5__stamp:hover {
    background: var(--color-sage);
    transform: rotate(-3deg) scale(1.04);
  }
  .v5__stamp:hover::before { border-color: rgba(255,255,255,0.5); }
  .v5__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    text-align: center;
    padding: 0 1rem;
  }
  .v5__top {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-weight: 700;
    color: var(--color-sage-dark);
    transition: color 0.35s ease;
  }
  .v5__mid {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    letter-spacing: 0.05em;
    font-weight: 400;
    color: var(--color-ink);
    line-height: 1;
    transition: color 0.35s ease;
  }
  .v5__bot {
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    color: var(--color-ink);
    font-weight: 600;
    opacity: 0.7;
    transition: color 0.35s ease, opacity 0.35s ease;
    word-break: break-all;
    text-align: center;
    max-width: 90%;
  }
  .v5__stamp:hover .v5__top,
  .v5__stamp:hover .v5__mid,
  .v5__stamp:hover .v5__bot { color: #ffffff; opacity: 1; }

  /* ============ Variante 6 · Link-Stack ============ */
  .v6__stack {
    display: flex;
    flex-direction: column;
    width: clamp(260px, 32vw, 360px);
  }
  .v6__item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--color-sage);
    background: #ffffff;
    text-decoration: none;
    transition: background 0.3s ease, transform 0.3s ease;
    position: relative;
  }
  .v6__item + .v6__item { margin-top: -1px; }
  .v6__item:hover { background: var(--color-badge-bg); transform: translateX(4px); z-index: 1; }
  .v6__icon {
    flex-shrink: 0;
    width: 40px; height: 40px;
    background: var(--color-sage);
    color: #ffffff;
    display: grid;
    place-items: center;
  }
  .v6__icon svg { width: 20px; height: 20px; }
  .v6__text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .v6__channel {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--color-sage-dark);
  }
  .v6__value {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .v6__arrow {
    color: var(--color-sage-dark);
    font-size: 1.1rem;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }
  .v6__item:hover .v6__arrow { transform: translateX(4px); }

  /* ============ Variante 7 · Polaroid ============ */
  .v7__polaroid {
    background: #fff;
    padding: 0.75rem 0.75rem 2.25rem;
    box-shadow: 0 8px 24px rgba(0,0,0,0.1), 0 2px 6px rgba(0,0,0,0.06);
    transform: rotate(-3deg);
    display: block;
    text-decoration: none;
    max-width: 200px;
    transition: transform 0.4s cubic-bezier(0.22,1,0.36,1), box-shadow 0.4s ease;
  }
  .v7__polaroid:hover { transform: rotate(0deg) translateY(-6px); box-shadow: 0 20px 40px rgba(0,0,0,0.14); }
  .v7__photo {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--color-border);
  }
  .v7__photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .v7__caption {
    font-family: 'Reenie Beanie', cursive;
    font-size: 1.75rem;
    color: var(--color-ink);
    text-align: center;
    margin: 0.5rem 0 0;
    line-height: 1;
  }

  /* ============ Variante 8 · Ticket ============ */
  .v8__ticket {
    display: flex;
    align-items: stretch;
    text-decoration: none;
    max-width: 380px;
    width: clamp(280px, 32vw, 380px);
    border: 1px solid var(--color-sage);
    background: #fff;
    overflow: hidden;
    position: relative;
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }
  .v8__ticket:hover { transform: translateY(-3px); box-shadow: 0 16px 32px -16px rgba(98,108,99,0.3); }
  .v8__left {
    flex: 1;
    padding: 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    background: var(--color-sage);
    color: #fff;
  }
  .v8__eyebrow {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 700;
    opacity: 0.8;
  }
  .v8__name {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    letter-spacing: 0.06em;
    font-weight: 400;
    line-height: 1.1;
  }
  .v8__role {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    opacity: 0.85;
  }
  .v8__tear {
    width: 1px;
    background-image: repeating-linear-gradient(to bottom, var(--color-sage) 0, var(--color-sage) 6px, transparent 6px, transparent 12px);
    flex-shrink: 0;
  }
  .v8__right {
    padding: 1.25rem 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }
  .v8__cta {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    letter-spacing: 0.05em;
    color: var(--color-ink);
    line-height: 1.1;
    text-align: center;
    font-weight: 400;
  }
  .v8__arrow { width: 22px; height: 22px; color: var(--color-sage-dark); }

  /* ============ Variante 9 · Status ============ */
  .v9__block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
  }
  .v9__status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--color-sage);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-sage-dark);
  }
  .v9__dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--color-sage);
    animation: v9-pulse 2s ease-out infinite;
    flex-shrink: 0;
  }
  @keyframes v9-pulse {
    0% { box-shadow: 0 0 0 0 rgba(128,149,130,0.55); }
    100% { box-shadow: 0 0 0 8px rgba(128,149,130,0); }
  }
  .v9__mail {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 2rem);
    letter-spacing: 0.04em;
    color: var(--color-ink);
    text-decoration: none;
    font-weight: 400;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 3px;
    border-bottom: 1px solid var(--color-ink);
    transition: color 0.3s ease, gap 0.3s ease;
  }
  .v9__mail:hover { color: var(--color-sage-dark); border-bottom-color: var(--color-sage-dark); gap: 1rem; }
  .v9__arrow { font-size: 1.25rem; }
  .v9__secondary {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-sage-dark);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
    transition: border-color 0.2s ease;
  }
  .v9__secondary:hover { border-bottom-color: var(--color-sage-dark); }
  @media (prefers-reduced-motion: reduce) { .v9__dot { animation: none; } }

  /* ============ Variante 10 · P.S. ============ */
  .v10__wrap {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1rem, 3vw, 2rem);
    align-items: start;
    border-top: 1px solid var(--color-sage);
    border-bottom: 1px solid var(--color-sage);
    padding-block: 1.5rem;
    max-width: 420px;
  }
  .v10__ps {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 7vw, 5.5rem);
    line-height: 0.85;
    letter-spacing: -0.02em;
    color: var(--color-sage);
    padding-top: 0.2rem;
    user-select: none;
  }
  .v10__body { display: flex; flex-direction: column; gap: 0.85rem; padding-top: 0.75rem; }
  .v10__text {
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.55;
    color: var(--color-ink);
    margin: 0;
    max-width: 30ch;
  }
  .v10__link {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1.5px solid var(--color-ink);
    padding-bottom: 2px;
    width: fit-content;
    transition: color 0.25s ease, border-color 0.25s ease;
  }
  .v10__link:hover { color: var(--color-sage-dark); border-bottom-color: var(--color-sage-dark); }

  /* ============ Variante 11 · Outline ============ */
  .v11__link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    line-height: 0.9;
    gap: 0;
  }
  .v11__outline {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 6rem);
    letter-spacing: 0.04em;
    font-weight: 400;
    color: transparent;
    -webkit-text-stroke: 2px var(--color-sage);
    transition: color 0.35s ease, -webkit-text-stroke-color 0.35s ease;
  }
  .v11__filled {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 6rem);
    letter-spacing: 0.04em;
    font-weight: 400;
    color: var(--color-ink);
    transition: color 0.35s ease;
  }
  .v11__link:hover .v11__outline { color: var(--color-sage); -webkit-text-stroke-color: var(--color-sage); }
  .v11__link:hover .v11__filled { color: var(--color-sage-dark); }

  /* ============ Variante 12 · Kachel-Grid ============ */
  .v12__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    width: clamp(240px, 28vw, 320px);
  }
  .v12__tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 1.5rem 1rem;
    border: 1px solid var(--color-sage);
    margin: -0.5px;
    background: #fff;
    color: var(--color-ink);
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: background 0.25s ease, color 0.25s ease;
  }
  .v12__tile svg { width: 22px; height: 22px; transition: transform 0.3s ease; }
  .v12__tile:hover { background: var(--color-sage); color: #fff; }
  .v12__tile:hover svg { transform: scale(1.15); }
  .v12__tile--accent { background: var(--color-sage); color: #fff; }
  .v12__tile--accent:hover { background: var(--color-sage-dark); }

  /* ============ Variante 13 · Briefumschlag ============ */
  .v13__env {
    display: block;
    position: relative;
    width: clamp(260px, 30vw, 340px);
    background: #fff;
    border: 1px solid var(--color-sage);
    text-decoration: none;
    /* kein overflow:hidden – sonst wird 3D-Klappe abgeschnitten */
    perspective: 900px;
    transition: box-shadow 0.4s ease, transform 0.4s ease;
  }
  .v13__env:hover {
    box-shadow: 0 22px 44px -18px rgba(98,108,99,0.32);
    transform: translateY(-4px);
  }

  /* Dreieck im Umschlag-Inneren – bleibt stehen, wird sichtbar wenn Lasche klappt */
  .v13__inner {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 76px;
    background: #e8ede8;
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    pointer-events: none;
  }

  /* Wrapper dreht sich um die Oberkante (3D) */
  .v13__flap-wrap {
    position: relative;
    width: 100%;
    height: 76px;
    transform-origin: 50% 0%;
    transform-style: preserve-3d;
    transform: rotateX(0deg);
    transition: transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
    z-index: 2;
  }
  .v13__env:hover .v13__flap-wrap {
    transform: rotateX(-172deg);
  }

  /* Vorderseite: Sage-Dreieck */
  .v13__face {
    position: absolute;
    inset: 0;
    background: var(--color-sage);
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    backface-visibility: hidden;
  }

  /* Rückseite: Innenseite der Lasche, erscheint wenn offen */
  .v13__back {
    position: absolute;
    inset: 0;
    background: #c8d4c9;
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    backface-visibility: hidden;
    transform: rotateX(180deg);
  }

  /* Briefkörper mit Falzlinien unten */
  .v13__body {
    position: relative;
    z-index: 1;
    padding: 0.85rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    /* Falzlinien: zwei diagonale Linien von den unteren Ecken zur Mitte */
    background-image:
      linear-gradient(to top right,
        transparent calc(50% - 0.5px),
        rgba(128,149,130,0.22) calc(50% - 0.5px),
        rgba(128,149,130,0.22) calc(50% + 0.5px),
        transparent calc(50% + 0.5px)),
      linear-gradient(to top left,
        transparent calc(50% - 0.5px),
        rgba(128,149,130,0.22) calc(50% - 0.5px),
        rgba(128,149,130,0.22) calc(50% + 0.5px),
        transparent calc(50% + 0.5px));
    background-size: 100% 38%;
    background-position: bottom;
    background-repeat: no-repeat;
  }
  /* Alle Textelemente starten unsichtbar */
  .v13__to,
  .v13__name,
  .v13__addr,
  .v13__hand {
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  /* Erscheinen gestaffelt wenn Lasche aufgeht */
  .v13__env:hover .v13__to   { opacity: 1; transform: none; transition-delay: 0.08s; }
  .v13__env:hover .v13__name { opacity: 1; transform: none; transition-delay: 0.14s; }
  .v13__env:hover .v13__addr { opacity: 1; transform: none; transition-delay: 0.20s; }
  /* Reenie Beanie erst ab der Hälfte der Klappenanimation (0.65s / 2 ≈ 0.33s) */
  .v13__env:hover .v13__hand { opacity: 1; transform: none; transition-delay: 0.33s; }

  .v13__to {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
    color: var(--color-sage-dark);
    margin: 0;
  }
  .v13__name {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.2vw, 1.65rem);
    letter-spacing: 0.05em;
    color: var(--color-ink);
    margin: 0.15rem 0 0;
    font-weight: 400;
    line-height: 1.1;
  }
  .v13__addr {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0.2rem 0 0;
  }
  .v13__hand {
    font-family: 'Reenie Beanie', cursive;
    font-size: 2rem;
    line-height: 1;
    color: var(--color-ink);
    margin: 0.6rem 0 0;
    transform-origin: left center;
  }

  /* ============ Variante 14 · Signatur + Chips ============ */
  .v14__block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .v14__sig {
    font-family: 'Reenie Beanie', cursive;
    font-size: clamp(3rem, 6vw, 4.5rem);
    line-height: 1;
    color: var(--color-ink);
    margin: 0;
    transform: rotate(-2deg);
    transform-origin: left;
  }
  .v14__chips {
    display: flex;
    flex-wrap: wrap;
