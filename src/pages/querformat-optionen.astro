---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';

const landscape = [
  { src: '/images/Fotografie/DSC02545-Verbessert-RR%20Kopie.jpg', alt: 'Portrait mit Seifenblasen, lachend nach oben blickend', title: 'Seifenblasen', meta: 'Portrait · 1. Semester', body: 'Ein spontaner Moment während des Portrait-Shoots. Der Kopf schaut nach oben, die Blasen tanzen im Licht.' },
  { src: '/images/Fotografie/ungeschnittenendversion.jpg', alt: 'Portrait mit Lichterkette im Hintergrund', title: 'Lichterketten', meta: 'Studio-Setup', body: 'Kontrolliertes Studio-Setup mit warmer Lichterkette als Hintergrund — Bokeh und Portraitlicht in Balance.' },
  { src: '/images/Fotografie/DSC02542-Verbessert-RR.jpg', alt: 'Portrait mit Seifenblasen, überrascht lachend', title: 'Überraschung', meta: 'Portrait · Serie', body: 'Aus derselben Serie wie das erste Bild — Fokus auf die Emotion, nicht auf Perfektion.' },
  { src: '/images/Fotografie/busch2.jpg', alt: 'Portrait vor grüner Hecke', title: 'Vor grüner Hecke', meta: 'Natur-Location', body: 'Portrait vor einer sattgrünen Hecke. Kontrast zwischen den Farben, kein zusätzliches Licht.' },
];

const options = [
  { id: '1', title: 'Sticky-Stack (Full-Bleed)', desc: 'Aktuelle Variante: jedes Bild füllt den Viewport, sticky Scroll mit Dwell-Time. Ruhig, cineastisch.' },
  { id: '2', title: 'Editorial-Grid (2 Spalten mit Meta-Zeile)', desc: 'Magazine-Look: 2 Spalten, gleich große Kacheln, Meta + Titel als Bildunterschrift daneben.' },
  { id: '3', title: 'Split-Screen Story (Bild + Text nebeneinander)', desc: 'Pro Bild eine Zeile: Bild links (oder rechts, alternierend), rechts Titel + kurzer Text. Sehr editorial.' },
  { id: '4', title: 'Ken-Burns Slideshow (Auto-Play mit sanftem Zoom)', desc: 'Ein großes Bild füllt den Bereich, wechselt alle paar Sekunden mit Cross-Fade + langsamer Scale-Bewegung.' },
  { id: '5', title: 'Cinema-Strip (Horizontales Scroll-Snap)', desc: 'Horizontal scrollbare Filmstreifen-Reihe. Jedes Bild rastet mittig ein, Caption drunter.' },
  { id: '6', title: 'Full-Bleed Parallax (Bild volle Breite, Text mit Offset)', desc: 'Jedes Bild spannt sich über die volle Fensterbreite mit dezenter Parallax-Bewegung. Text-Box mit weißem Hintergrund über dem Bild.' },
  { id: '7', title: 'Sticky-Story (Bild bleibt, Text scrollt)', desc: 'Wie bei den Portraits: Bild bleibt links sticky, rechts scrollt Titel + Text vorbei, Bild wechselt via Cross-Fade.' },
  { id: '8', title: 'Bento-Grid (1 Hero + 3 kleine)', desc: 'Asymmetrisches Grid: ein großes Hero-Bild, drei kleinere daneben in unterschiedlichen Zellen.' },
  { id: '9', title: 'Contact-Sheet mit Hover-Zoom', desc: 'Dichtes Thumbnail-Grid im Kontaktbogen-Look. Beim Hover zoomt das Bild sanft rein.' },
  { id: '10', title: 'Timeline mit Datum', desc: 'Horizontale Zeitleiste: über jedem Bild ein Datum-Chip, verbindende Linie durch alle Bilder.' },
  { id: '11', title: 'Marquee (Auto-Scroll Filmstreifen)', desc: 'Dauerhaft nach links laufende Reihe. Hover pausiert. Sehr modern und „ambient".' },
  { id: '12', title: 'Diagonal-Collage (überlappend, leicht rotiert)', desc: 'Bilder überlappen sich leicht, jedes leicht rotiert — wie ein Moodboard. Hover richtet das Bild auf.' },
  { id: '13', title: 'Typo-Cutout (Bild in Wort)', desc: 'Ein riesiges Wort ("FOTOGRAFIE") wird mit dem Foto gefüllt. Beim Scrollen wechselt das Bild in der Typo. Sehr auffällig, editorial-experimentell.' },
  { id: '14', title: 'Cover-Flow (3D-Karussell)', desc: 'Ein Bild mittig frontal, die Nachbarn seitlich gekippt in 3D. Klick oder Pfeiltaste wechselt.' },
  { id: '15', title: 'Streifen-Reveal (Bild in Slices)', desc: 'Jedes Bild ist in vertikale Streifen zerlegt, die abwechselnd von oben/unten reinschieben.' },
  { id: '16', title: 'Radial-Arc (Kreisbogen-Anordnung)', desc: 'Bilder sitzen entlang eines Kreisbogens — wie Fächer aufgespannt, jedes leicht anders geneigt.' },
  { id: '17', title: 'Dual-Layer (Blur-Background + Focus-Card)', desc: 'Großes unscharfes Bild als Hintergrund, kleines scharfes Detail-Foto zentriert davor. Wechselt beim Scrollen.' },
  { id: '18', title: 'Draggable Deck (Karten-Stapel zum Durchziehen)', desc: 'Karten liegen aufeinander gestapelt. User zieht (Drag oder Wisch) die oberste weg, die nächste wird sichtbar.' },
  { id: '19', title: 'Accordion-Balken (Klick öffnet)', desc: 'Vertikale Balken nebeneinander. Ein Balken ist groß (aktives Bild mit Titel & Info), die anderen bleiben als schmale Balken mit vertikalem Label. Klick auf einen Balken macht ihn zum aktiven Bild.' },
];

const accordionImages = [
  { src: '/images/Fotografie/DSC02545-Verbessert-RR%20Kopie.jpg', label: 'Seifenblasen', count: '4 Fotos', location: 'Portrait-Serie' },
  { src: '/images/Fotografie/ungeschnittenendversion.jpg', label: 'Lichterketten', count: '2 Fotos', location: 'Studio' },
  { src: '/images/Fotografie/DSC02542-Verbessert-RR.jpg', label: 'Überraschung', count: '3 Fotos', location: 'Portrait' },
  { src: '/images/Fotografie/busch2.jpg', label: 'Grüne Hecke', count: '2 Fotos', location: 'Natur' },
];
---

<BaseLayout title="Querformat-Optionen — Emma Eichin" description="Vorschau verschiedener Darstellungsvarianten für Querformat-Fotos." robots="noindex, nofollow">
  <Header />
  <main class="options-page">
    <section class="section options-intro">
      <div class="wrapper">
        <h1 class="options-title">Vorschau: Querformat-Darstellungen</h1>
        <p class="options-lead">Neunzehn Varianten für die Landscape-Bilder — Standard bis experimentell. Scroll durch und sag, welche dir gefällt.</p>
        <nav class="options-nav">
          {options.map((o) => (
            <a href={`#opt-${o.id}`}>{o.id}. {o.title}</a>
          ))}
        </nav>
      </div>
    </section>

    {/* Option 1: Sticky-Stack (current) */}
    <section id="opt-1" class="section option-block">
      <div class="wrapper">
        <div class="option-heading">
          <span class="option-badge">Option 1</span>
          <h2>{options[0].title}</h2>
          <p>{options[0].desc}</p>
        </div>
      </div>

      <div class="wrapper">
        <div class="ls-stack">
          {landscape.map((p, i) => (
            <figure class="ls-stack__item" style={`z-index: ${i + 1}`}>
              <div class="ls-stack__image">
                <img src={p.src} alt={p.alt} loading="lazy" />
                <figcaption class="ls-stack__caption">{p.title} · {p.meta}</figcaption>
              </div>
            </figure>
          ))}
        </div>
      </div>
    </section>

    {/* Option 2: Editorial Grid */}
    <section id="opt-2" class="section option-block">
      <div class="wrapper">
        <div class="option-heading">
          <span class="option-badge">Option 2</span>
          <h2>{options[1].title}</h2>
          <p>{options[1].desc}</p>
        </div>

        <div class="ls-editorial">
          {landscape.map((p) => (
            <figure class="ls-editorial__item">
              <img src={p.src} alt={p.alt} loading="lazy" />
              <figcaption>
                <span class="ls-editorial__title">{p.title}</span>
                <span class="ls-editorial__meta">{p.meta}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    {/* Option 3: Split-Screen alternierend */}
    <section id="opt-3" class="section option-block">
      <div class="wrapper">
        <div class="option-heading">
          <span class="option-badge">Option 3</span>
          <h2>{options[2].title}</h2>
          <p>{options[2].desc}</p>
        </div>

        <div class="ls-split">
          {landscape.map((p, i) => (
            <article class={`ls-split__row ${i % 2 === 1 ? 'is-flipped' : ''}`}>
              <div class="ls-split__media">
                <img src={p.src} alt={p.alt} loading="lazy" />
              </div>
              <div class="ls-split__text">
                <span class="ls-split__meta">{p.meta}</span>
                <h3 class="ls-split__title">{p.title}</h3>
                <p class="ls-split__body">{p.body}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* Option 4: Ken-Burns Slideshow */}
    <section id="opt-4" class="section option-block">
      <div class="wrapper">
        <div class="option-heading">
          <span class="option-badge">Option 4</span>
          <h2>{options[3].title}</h2>
          <p>{options[3].desc}</p>
        </div>

        <div class="kenburns" data-kenburns>
          {landscape.map((p, i) => (
            <div class={`kenburns__slide ${i === 0 ? 'is-active' : ''}`} data-index={i}>
              <img src={p.src} alt={p.alt} loading={i === 0 ? 'eager' : 'lazy'} />
              <div class="kenburns__caption">
                <span class="kenburns__meta">{p.meta}</span>
                <span class="kenburns__title">{p.title}</span>
              </div>
            </div>
          ))}
          <div class="kenburns__dots" aria-hidden="true">
            {landscape.map((_, i) => (
              <span class={`kenburns__dot ${i === 0 ? 'is-active' : ''}`} data-dot={i}></span>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* Option 5: Cinema-Strip Scroll-Snap */}
    <section id="opt-5" class="section option-block option-block--full">
      <div class="wrapper">
        <div class="option-heading">
          <span class="option-badge">Option 5</span>
          <h2>{options[4].title}</h2>
          <p>{options[4].desc}</p>
          <p class="option-hint">Tipp: mit dem Trackpad horizontal wischen.</p>
        </div>
      </div>

      <div class="cinema-strip">
        {landscape.map((p) => (
          <figure class="cinema-strip__item">
            <img src={p.src} alt={p.alt} loading="lazy" />
            <figcaption>
              <span>{p.title}</span>
              <span class="cinema-strip__meta">{p.meta}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    {/* Option 6: Full-Bleed Parallax */}
    <section id="opt-6" class="section option-block option-block--full">
      <div class="wrapper">
        <div class="option-heading">
          <span class="option-badge">Option 6</span>
          <h2>{options[5].title}</h2>
          <p>{options[5].desc}</p>
        </div>
      </div>

      <div class="parallax-list" data-parallax>
        {landscape.map((p) => (
          <section class="parallax-list__row">
            <div class="parallax-list__bg" data-parallax-bg>
              <img src={p.src} alt={p.alt} loading="lazy" />
            </div>
            <div class="parallax-list__card">
              <span class="parallax-list__meta">{p.meta}</span>
              <h3 class="parallax-list__title">{p.title}</h3>
              <p class="parallax-list__body">{p.body}</p>
            </div>
          </section>
        ))}
      </div>
    </section>

    {/* Option 7: Sticky-Story (Landscape) */}
    <section id="opt-7" class="section option-block">
      <div class="wrapper">
        <div class="option-heading">
          <span class="option-badge">Option 7</span>
          <h2>{options[6].title}</h2>
          <p>{options[6].desc}</p>
        </div>

        <div class="ls-story" data-ls-story>
          <div class="ls-story__media">
            {landscape.map((p, i) => (
              <div class={`ls-story__photo${i === 0 ? ' is-active' : ''}`} data-index={i}>
                <img src={p.src} alt={p.alt} loading="lazy" />
              </div>
            ))}
          </div>
          <div class="ls-story__text">
            {landscape.map((p, i) => (
              <article class="ls-story__block" data-index={i}>
                <span class="ls-story__meta">{p.meta}</span>
                <h3 class="ls-story__title">{p.title}</h3>
                <p class="ls-story__body">{p.body}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* Option 8: Bento-Grid */}
    <section id="opt-8" class="section option-block">
      <div class="wrapper">
        <div class="option-heading">
          <span class="option-badge">Option 8</span>
          <h2>{options[7].title}</h2>
          <p>{options[7].desc}</p>
        </div>

        <div class="bento">
          {landscape.slice(0, 4).map((p, i) => (
            <figure class={`bento__item bento__item--${i + 1}`}>
              <img src={p.src} alt={p.alt} loading="lazy" />
              <figcaption>
                <span class="bento__meta">{p.meta}</span>
                <span class="bento__title">{p.title}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    {/* Option 9: Contact-Sheet mit Hover-Zoom */}
    <section id="opt-9" class="section option-block">
      <div class="wrapper">
        <div class="option-heading">
          <span class="option-badge">Option 9</span>
          <h2>{options[8].title}</h2>
          <p>{options[8].desc}</p>
        </div>

        <div class="contact-sheet">
          {[...landscape, ...landscape].map((p, i) => (
            <figure class="contact-sheet__item">
              <img src={p.src} alt={p.alt} loading="lazy" />
              <figcaption class="contact-sheet__label">#{String(i + 1).padStart(2, '0')}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    {/* Option 10: Timeline mit Datum */}
    <section id="opt-10" class="section option-block option-block--full">
      <div class="wrapper">
        <div class="option-heading">
          <span class="option-badge">Option 10</span>
          <h2>{options[9].title}</h2>
          <p>{options[9].desc}</p>
        </div>
      </div>

      <div class="ls-timeline">
        <div class="ls-timeline__line" aria-hidden="true"></div>
        {landscape.map((p, i) => (
          <figure class="ls-timeline__item">
            <span class="ls-timeline__date">{`0${i + 1}/2024`}</span>
            <span class="ls-timeline__dot" aria-hidden="true"></span>
            <div class="ls-timeline__frame">
              <img src={p.src} alt={p.alt} loading="lazy" />
            </div>
            <figcaption>{p.title}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    {/* Option 11: Marquee (Landscape) */}
    <section id="opt-11" class="section option-block option-block--full">
      <div class="wrapper">
        <div class="option-heading">
          <span class="option-badge">Option 11</span>
          <h2>{options[10].title}</h2>
          <p>{options[10].desc}</p>
        </div>
      </div>

      <div class="ls-marquee">
        <div class="ls-marquee__track">
          {[...landscape, ...landscape, ...landscape].map((p) => (
            <figure class="ls-marquee__item">
              <img src={p.src} alt={p.alt} loading="lazy" />
              <figcaption>{p.title}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    {/* Option 12: Diagonal-Collage */}
    <section id="opt-12" class="section option-block">
      <div class="wrapper">
        <div class="option-heading">
          <span class="option-badge">Option 12</span>
          <h2>{options[11].title}</h2>
          <p>{options[11].desc}</p>
        </div>

        <div class="ls-collage">
          {landscape.map((p, i) => (
            <figure class={`ls-collage__item ls-collage__item--${i + 1}`}>
              <img src={p.src} alt={p.alt} loading="lazy" />
              <figcaption>{p.title}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    {/* Option 13: Typo-Cutout */}
    <section id="opt-13" class="section option-block option-block--full">
      <div class="wrapper">
        <div class="option-heading">
          <span class="option-badge">Option 13</span>
          <h2>{options[12].title}</h2>
          <p>{options[12].desc}</p>
        </div>
      </div>

      <div class="typo-cutout" data-typo-cutout>
        {landscape.map((p, i) => (
          <div class={`typo-cutout__slide${i === 0 ? ' is-active' : ''}`} data-index={i} style={`background-image: url('${p.src}')`}>
            <span class="typo-cutout__word">FOTOGRAFIE</span>
            <span class="typo-cutout__meta">{p.title} · {p.meta}</span>
          </div>
        ))}
      </div>
    </section>

    {/* Option 14: Cover-Flow */}
    <section id="opt-14" class="section option-block option-block--full">
      <div class="wrapper">
        <div class="option-heading">
          <span class="option-badge">Option 14</span>
          <h2>{options[13].title}</h2>
          <p>{options[13].desc}</p>
        </div>
      </div>

      <div class="coverflow" data-coverflow>
        <button type="button" class="coverflow__arrow coverflow__arrow--prev" data-cf-prev aria-label="Zurück">‹</button>
        <div class="coverflow__stage">
          {landscape.map((p, i) => (
            <figure class={`coverflow__item${i === 0 ? ' is-active' : ''}`} data-index={i}>
              <img src={p.src} alt={p.alt} loading="lazy" />
              <figcaption>{p.title}</figcaption>
            </figure>
          ))}
        </div>
        <button type="button" class="coverflow__arrow coverflow__arrow--next" data-cf-next aria-label="Weiter">›</button>
      </div>
    </section>

    {/* Option 15: Streifen-Reveal */}
    <section id="opt-15" class="section option-block">
      <div class="wrapper">
        <div class="option-heading">
          <span class="option-badge">Option 15</span>
          <h2>{options[14].title}</h2>
          <p>{options[14].desc}</p>
        </div>

        <div class="slice-reveal">
          {landscape.map((p) => (
            <figure class="slice-reveal__item" data-slice-reveal>
              <div class="slice-reveal__slices" aria-hidden="true">
                {Array.from({ length: 6 }).map((_, s) => (
                  <span class="slice-reveal__slice" style={`background-image: url('${p.src}'); background-position: ${(-s * 100) / 5}% center; --i: ${s}`}></span>
                ))}
              </div>
              <img src={p.src} alt={p.alt} loading="lazy" />
              <figcaption>{p.title}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    {/* Option 16: Radial-Arc */}
    <section id="opt-16" class="section option-block option-block--full">
      <div class="wrapper">
        <div class="option-heading">
          <span class="option-badge">Option 16</span>
          <h2>{options[15].title}</h2>
          <p>{options[15].desc}</p>
        </div>
      </div>

      <div class="arc-fan">
        {landscape.map((p, i) => (
          <figure class="arc-fan__item" style={`--i: ${i}; --total: ${landscape.length};`}>
            <img src={p.src} alt={p.alt} loading="lazy" />
            <figcaption>{p.title}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    {/* Option 17: Dual-Layer Blur */}
    <section id="opt-17" class="section option-block option-block--full">
      <div class="wrapper">
        <div class="option-heading">
          <span class="option-badge">Option 17</span>
          <h2>{options[16].title}</h2>
          <p>{options[16].desc}</p>
        </div>
      </div>

      <div class="dual-layer" data-dual-layer>
        {landscape.map((p, i) => (
          <div class={`dual-layer__slide${i === 0 ? ' is-active' : ''}`} data-index={i}>
            <img class="dual-layer__bg" src={p.src} alt="" aria-hidden="true" />
            <div class="dual-layer__card">
              <img src={p.src} alt={p.alt} loading="lazy" />
              <figcaption>
                <span class="dual-layer__meta">{p.meta}</span>
                <span class="dual-layer__title">{p.title}</span>
              </figcaption>
            </div>
          </div>
        ))}
        <div class="dual-layer__dots" aria-hidden="true">
          {landscape.map((_, i) => (
            <button type="button" class={`dual-layer__dot${i === 0 ? ' is-active' : ''}`} data-index={i} aria-label={`Zeige Bild ${i + 1}`}></button>
          ))}
        </div>
      </div>
    </section>

    {/* Option 18: Draggable Deck */}
    <section id="opt-18" class="section option-block">
      <div class="wrapper">
        <div class="option-heading">
          <span class="option-badge">Option 18</span>
          <h2>{options[17].title}</h2>
          <p>{options[17].desc}</p>
          <p class="option-hint">Zieh die oberste Karte weg oder klick auf sie.</p>
        </div>

        <div class="deck" data-deck>
          {landscape.map((p, i) => (
            <figure class="deck__card" data-index={i} style={`--i: ${i};`}>
              <img src={p.src} alt={p.alt} loading="lazy" draggable="false" />
              <figcaption>
                <span class="deck__title">{p.title}</span>
                <span class="deck__meta">{p.meta}</span>
              </figcaption>
            </figure>
          ))}
          <button type="button" class="deck__reset" data-deck-reset>Neu stapeln</button>
        </div>
      </div>
    </section>

    {/* Option 19: Accordion-Balken */}
    <section id="opt-19" class="section option-block option-block--full">
      <div class="wrapper">
        <div class="option-heading">
          <span class="option-badge">Option 19</span>
          <h2>{options[18].title}</h2>
          <p>{options[18].desc}</p>
          <p class="option-hint">Klick auf einen Balken macht ihn zum aktiven Bild.</p>
        </div>
      </div>

      <div class="accordion" data-accordion>
        {accordionImages.map((p, i) => (
          <button
            type="button"
            class={`accordion__panel${i === 0 ? ' is-active' : ''}`}
            data-index={i}
            aria-label={`${p.label} anzeigen`}
            style={`background-image: url('${p.src}')`}
          >
            <span class="accordion__vertical">{p.label}</span>
            <span class="accordion__count">{p.count}</span>
            <span class="accordion__horizontal">
              <span class="accordion__title">{p.label}</span>
              <span class="accordion__subtitle">{p.location} · Fotos ansehen ↓</span>
            </span>
          </button>
        ))}
      </div>
    </section>

    <script is:inline>
      /* Option 4: Ken-Burns Auto-Play */
      (() => {
        const root = document.querySelector('[data-kenburns]');
        if (!root) return;
        const slides = root.querySelectorAll('.kenburns__slide');
        const dots = root.querySelectorAll('.kenburns__dot');
        let idx = 0;
        let timer;
        const show = (i) => {
          idx = (i + slides.length) % slides.length;
          slides.forEach((s, si) => s.classList.toggle('is-active', si === idx));
          dots.forEach((d, di) => d.classList.toggle('is-active', di === idx));
        };
        const start = () => { timer = setInterval(() => show(idx + 1), 5000); };
        const stop = () => clearInterval(timer);
        dots.forEach((d, i) => d.addEventListener('click', () => { stop(); show(i); start(); }));
        root.addEventListener('mouseenter', stop);
        root.addEventListener('mouseleave', start);
        start();
      })();

      /* Option 7: Sticky-Story Landscape — Cross-Fade beim Vorbeiscrollen */
      (() => {
        const root = document.querySelector('[data-ls-story]');
        if (!root) return;
        const photos = root.querySelectorAll('.ls-story__photo');
        const blocks = root.querySelectorAll('.ls-story__block');
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const idx = Number(entry.target.dataset.index);
              photos.forEach((p) => p.classList.toggle('is-active', Number(p.dataset.index) === idx));
            }
          });
        }, { threshold: 0.55 });
        blocks.forEach((b) => observer.observe(b));
      })();

      /* Option 6: Parallax */
      (() => {
        const root = document.querySelector('[data-parallax]');
        if (!root) return;
        const bgs = root.querySelectorAll('[data-parallax-bg]');
        const update = () => {
          bgs.forEach((bg) => {
            const rect = bg.getBoundingClientRect();
            const vh = window.innerHeight;
            const progress = (rect.top + rect.height / 2) / (vh + rect.height);
            const shift = (0.5 - progress) * 40;
            const img = bg.querySelector('img');
            if (img) img.style.transform = `translate3d(0, ${shift}px, 0) scale(1.15)`;
          });
        };
        window.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
        window.addEventListener('resize', update);
        update();
      })();

      /* Option 13: Typo-Cutout — Bildwechsel per Auto-Play */
      (() => {
        const root = document.querySelector('[data-typo-cutout]');
        if (!root) return;
        const slides = root.querySelectorAll('.typo-cutout__slide');
        let i = 0;
        setInterval(() => {
          i = (i + 1) % slides.length;
          slides.forEach((s, si) => s.classList.toggle('is-active', si === i));
        }, 3500);
      })();

      /* Option 14: Cover-Flow */
      (() => {
        const root = document.querySelector('[data-coverflow]');
        if (!root) return;
        const items = Array.from(root.querySelectorAll('.coverflow__item'));
        const prev = root.querySelector('[data-cf-prev]');
        const next = root.querySelector('[data-cf-next]');
        let idx = 0;
        const layout = () => {
          items.forEach((el, i) => {
            const offset = i - idx;
            const abs = Math.abs(offset);
            const tx = offset * 40;
            const ty = abs * 0;
            const rot = offset * -22;
            const scale = 1 - Math.min(abs * 0.12, 0.55);
            const z = 100 - abs;
            const opacity = abs > 3 ? 0 : 1;
            el.style.transform = `translate3d(${tx}%, ${ty}%, 0) rotateY(${rot}deg) scale(${scale})`;
            el.style.zIndex = String(z);
            el.style.opacity = String(opacity);
            el.classList.toggle('is-active', i === idx);
          });
        };
        prev.addEventListener('click', () => { idx = (idx - 1 + items.length) % items.length; layout(); });
        next.addEventListener('click', () => { idx = (idx + 1) % items.length; layout(); });
        items.forEach((el, i) => el.addEventListener('click', () => { idx = i; layout(); }));
        window.addEventListener('keydown', (e) => {
          if (!root.matches(':hover')) return;
          if (e.key === 'ArrowLeft') { idx = (idx - 1 + items.length) % items.length; layout(); }
          if (e.key === 'ArrowRight') { idx = (idx + 1) % items.length; layout(); }
        });
        layout();
      })();

      /* Option 15: Streifen-Reveal — animiere beim Einblenden */
      (() => {
        const items = document.querySelectorAll('[data-slice-reveal]');
        if (!items.length) return;
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.35 });
        items.forEach((el) => observer.observe(el));
      })();

      /* Option 17: Dual-Layer — Dots wechseln Bild */
      (() => {
        const root = document.querySelector('[data-dual-layer]');
        if (!root) return;
        const slides = root.querySelectorAll('.dual-layer__slide');
        const dots = root.querySelectorAll('.dual-layer__dot');
        let i = 0;
        const show = (n) => {
          i = (n + slides.length) % slides.length;
          slides.forEach((s, si) => s.classList.toggle('is-active', si === i));
          dots.forEach((d, di) => d.classList.toggle('is-active', di === i));
        };
        dots.forEach((d, di) => d.addEventListener('click', () => show(di)));
        let timer = setInterval(() => show(i + 1), 4500);
        root.addEventListener('mouseenter', () => clearInterval(timer));
        root.addEventListener('mouseleave', () => { timer = setInterval(() => show(i + 1), 4500); });
      })();

      /* Option 18: Draggable Deck */
      (() => {
        const root = document.querySelector('[data-deck]');
        if (!root) return;
        const cards = Array.from(root.querySelectorAll('.deck__card'));
        const resetBtn = root.querySelector('[data-deck-reset]');
        let removed = [];

        const setStack = () => {
          const visible = cards.filter((c) => !removed.includes(c));
          visible.forEach((c, i) => {
            c.style.setProperty('--stack', i);
            c.style.zIndex = String(1000 - i);
            c.style.pointerEvents = i === 0 ? 'auto' : 'none';
          });
        };

        const swipe = (card, dir = 1) => {
          card.style.transition = 'transform 400ms ease, opacity 400ms ease';
          card.style.transform = `translate3d(${dir * 130}%, -20%, 0) rotate(${dir * 15}deg)`;
          card.style.opacity = '0';
          setTimeout(() => {
            removed.push(card);
            setStack();
          }, 400);
        };

        cards.forEach((card) => {
          let startX = null;
          let currentX = 0;
          const onStart = (x) => { startX = x; card.style.transition = 'none'; };
          const onMove = (x) => {
            if (startX === null) return;
            currentX = x - startX;
            card.style.transform = `translate3d(${currentX}px, 0, 0) rotate(${currentX / 30}deg)`;
          };
          const onEnd = () => {
            if (startX === null) return;
            if (Math.abs(currentX) > 100) {
              swipe(card, currentX > 0 ? 1 : -1);
            } else {
              card.style.transition = 'transform 250ms ease';
              card.style.transform = '';
            }
            startX = null;
            currentX = 0;
          };
          card.addEventListener('pointerdown', (e) => { card.setPointerCapture(e.pointerId); onStart(e.clientX); });
          card.addEventListener('pointermove', (e) => onMove(e.clientX));
          card.addEventListener('pointerup', onEnd);
          card.addEventListener('pointercancel', onEnd);
          card.addEventListener('click', () => { if (currentX === 0 && startX === null) swipe(card, 1); });
        });

        resetBtn.addEventListener('click', () => {
          removed = [];
          cards.forEach((c) => { c.style.transition = 'transform 400ms ease, opacity 400ms ease'; c.style.transform = ''; c.style.opacity = ''; });
          setTimeout(setStack, 50);
        });

        setStack();
      })();

      /* Option 19: Accordion-Balken */
      (() => {
        const root = document.querySelector('[data-accordion]');
        if (!root) return;
        const panels = root.querySelectorAll('.accordion__panel');
        panels.forEach((panel) => {
          panel.addEventListener('click', () => {
            panels.forEach((p) => p.classList.toggle('is-active', p === panel));
          });
          panel.addEventListener('mouseenter', () => {
            panels.forEach((p) => p.classList.toggle('is-active', p === panel));
          });
        });
      })();
    </script>
  </main>
</BaseLayout>

