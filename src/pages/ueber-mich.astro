---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Process from '../components/Process.astro';
import Skills from '../components/Skills.astro';
import Footer from '../components/Footer.astro';

const bioHtml = `
  <p>Ich bin Emma, 22, und studiere aktuell <strong>Mediendesign (B.Sc.)</strong> im 5. Semester an der RWU in Weingarten mit großer Leidenschaft für <strong>UI/UX</strong>. Mich reizt die Herausforderung, digitale Produkte nicht nur visuell ansprechend, sondern auch logisch und intuitiv bedienbar zu machen.</p>
  <p>Meine Begeisterung für Gestaltung begann schon lange vor dem Studium: Bereits während der Schulzeit nutzte ich jede Gelegenheit, um <strong>kreativ zu sein</strong> – von Schulpräsentationen bis zu individuellen Einladungs- und Menükarten im privaten Umfeld.</p>
  <p>Mein damaliger Schulschwerpunkt in <strong>Psychologie</strong> schlägt dabei die perfekte Brücke zur <strong>User Experience</strong>: Ich finde es total spannend, tief in die Lebenswelt der Zielgruppen einzutauchen, um deren Bedürfnisse zu erfassen. So entstehen passgenaue Designlösungen, die im Alltag intuitiv funktionieren und echten Mehrwert bieten.</p>
  <p>Neben dem Design <strong>reise und backe</strong> ich gern, fange Momente <strong>fotografisch</strong> ein und habe eine <strong>Schwäche für Sonnenuntergänge</strong>.</p>
`;

const werdegang = [
  { date: '2023', title: 'Fachgebundene Hochschulreife', subtitle: 'an der FOS/BOS in Memmingen' },
  { date: '11/2023 – 08/2024', title: 'Aushilfstätigkeiten', subtitle: 'im Kutter Gartencenter & Rituals' },
  { date: 'seit 10/2024', title: 'Mediendesign (B.Sc.)', subtitle: 'an der RWU in Weingarten' },
  { date: 'seit 10/2026', title: 'UX-Design Tutorin', subtitle: 'an der RWU in Weingarten', variant: 'dark' },
];

const bgImages = [
  // Obere Reihe — gleichmäßig verteilt
  { src: '/images/bilder-animation-trail/IMG_0534.JPG',         top: '6%',  left: '2%',  rot: '-7deg', size: 'clamp(95px, 11vw, 145px)' },
  { src: '/images/bilder-animation-trail/IMG_4082.JPG',         top: '3%',  left: '25%', rot: '4deg',  size: 'clamp(90px, 10vw, 135px)' },
  { src: '/images/bilder-animation-trail/IMG_1331.JPG',         top: '5%',  left: '62%', rot: '-4deg', size: 'clamp(90px, 10vw, 135px)' },
  { src: '/images/bilder-animation-trail/20250829_194046.JPG',  top: '7%',  left: '83%', rot: '6deg',  size: 'clamp(95px, 11vw, 145px)' },
  // Untere Reihe — gleichmäßig verteilt
  { src: '/images/bilder-animation-trail/FullSizeRender_2.jpg', top: '64%', left: '2%',  rot: '5deg',  size: 'clamp(95px, 11vw, 145px)' },
  { src: '/images/bilder-animation-trail/IMG_8522.JPG',         top: '67%', left: '41%', rot: '-3deg', size: 'clamp(90px, 10vw, 135px)' },
  { src: '/images/bilder-animation-trail/IMG_7994.JPG',         top: '63%', left: '81%', rot: '-6deg', size: 'clamp(95px, 11vw, 145px)' },
];

const trailImages = [
  '/images/bilder-animation-trail/0B1029F6-3106-40C8-8197-39A3CCAC978F.JPG',
  '/images/bilder-animation-trail/20250829_194046.JPG',
  '/images/bilder-animation-trail/2941700c-95bc-4e73-9cd5-7291fe50de6f.JPG',
  '/images/bilder-animation-trail/4044E22F-6B73-45A1-8CEC-AA34A7F5834F.JPG',
  '/images/bilder-animation-trail/6cc8f6f9-b809-4a48-8163-3acb4727db0a.JPG',
  '/images/bilder-animation-trail/FullSizeRender_2.jpg',
  '/images/bilder-animation-trail/FullSizeRender_3.jpg',
  '/images/bilder-animation-trail/FullSizeRender_4.jpg',
  '/images/bilder-animation-trail/FullSizeRender_5.jpg',
  '/images/bilder-animation-trail/FullSizeRender_6.jpg',
  '/images/bilder-animation-trail/FullSizeRender_14.JPG',
  '/images/bilder-animation-trail/FullSizeRender.jpg',
  '/images/bilder-animation-trail/IMG_0534.JPG',
  '/images/bilder-animation-trail/IMG_0541.jpg',
  '/images/bilder-animation-trail/IMG_0559.JPG',
  '/images/bilder-animation-trail/IMG_1075.JPG',
  '/images/bilder-animation-trail/IMG_1331.JPG',
  '/images/bilder-animation-trail/IMG_2600.JPG',
  '/images/bilder-animation-trail/IMG_3155.jpg',
  '/images/bilder-animation-trail/IMG_3978.JPG',
  '/images/bilder-animation-trail/IMG_4082.JPG',
  '/images/bilder-animation-trail/IMG_4117.JPG',
  '/images/bilder-animation-trail/IMG_4324.JPG',
  '/images/bilder-animation-trail/IMG_4487.JPG',
  '/images/bilder-animation-trail/IMG_4502.JPG',
  '/images/bilder-animation-trail/IMG_4922.JPG',
  '/images/bilder-animation-trail/IMG_4936.JPG',
  '/images/bilder-animation-trail/IMG_5263.JPG',
  '/images/bilder-animation-trail/IMG_6705.jpg',
  '/images/bilder-animation-trail/IMG_6938.JPG',
  '/images/bilder-animation-trail/IMG_7795.JPG',
  '/images/bilder-animation-trail/IMG_7994.JPG',
  '/images/bilder-animation-trail/IMG_8077.jpg',
  '/images/bilder-animation-trail/IMG_8522.JPG',
  '/images/bilder-animation-trail/IMG_8969.JPG',
  '/images/bilder-animation-trail/IMG_9884.JPG',
];
---

<BaseLayout
  title="Über mich - Emma Eichin"
  description="Emma Eichin: Mediendesign-Studentin an der RWU Weingarten mit Leidenschaft für UI/UX-Design, Fotografie und Reisen."
>
  <Header />
  <main>
    <section class="section case-hero">
      <div class="wrapper case-hero__inner">
        <div class="case-hero__content">
          <div class="case-hero__media about-media" data-reveal style="--reveal-delay: 120ms">
            <figure class="polaroid">
              <img
                src="/images/emma.JPG"
                alt="Porträtfoto von Emma"
                width="538"
                height="921"
                loading="eager"
              />
            </figure>
          </div>
          <h1 class="case-hero__title">
            <span data-split="chars" style="--split-delay: 120ms">Schön, dass</span><br />
            <span data-split="chars" style="--split-delay: 420ms">du hier bist!</span>
          </h1>
          <div class="about-bio" data-reveal style="--reveal-delay: 80ms" set:html={bioHtml} />
        </div>
      </div>
    </section>

    <section id="werdegang" class="section" style="padding-bottom: clamp(5rem, 12vw, 10rem);">
      <div class="wrapper">
        <h2 class="section-heading" data-reveal>Werdegang</h2>

        <div class="timeline" data-reveal style="--reveal-delay: 80ms">
          {werdegang.map((station, i) => (
            <div class="timeline__station">
              <div class="timeline__top" style={`grid-column: ${i + 1}`}>
                {i % 2 === 0 ? (
                  <span class="timeline__date">{station.date}</span>
                ) : (
                  <span class:list={["timeline__chip", station.variant === 'dark' && "timeline__chip--dark"]}>
                    <span class="timeline__chip-inner">
                      <span class="timeline__chip-title">{station.title}</span>
                      <span class="timeline__chip-subtitle">{station.subtitle}</span>
                    </span>
                  </span>
                )}
              </div>
              <span class:list={["timeline__dot", station.variant === 'dark' && "timeline__dot--dark"]} style={`grid-column: ${i + 1}`}></span>
              <div class="timeline__bottom" style={`grid-column: ${i + 1}`}>
                {i % 2 === 0 ? (
                  <span class:list={["timeline__chip", station.variant === 'dark' && "timeline__chip--dark"]}>
                    <span class="timeline__chip-inner">
                      <span class="timeline__chip-title">{station.title}</span>
                      <span class="timeline__chip-subtitle">{station.subtitle}</span>
                    </span>
                  </span>
                ) : (
                  <span class="timeline__date">{station.date}</span>
                )}
              </div>
            </div>
          ))}
          <div class="timeline__line"></div>
        </div>
      </div>
    </section>

    <section class="section about-more">
      <div class="wrapper">
        <h2 class="section-heading" data-split>Mehr zu mir</h2>
      </div>
      <div class="about-more__canvas" data-trail={trailImages.join('|')}>
        <div class="about-more__bg" aria-hidden="true">
          {bgImages.map((img) => (
            <img
              src={img.src}
              alt=""
              class="about-more__bg-img"
              style={`top:${img.top};left:${img.left};transform:rotate(${img.rot});width:${img.size};`}
              loading="lazy"
            />
          ))}
        </div>
        <p class="about-more__hint" aria-hidden="true">
          <span class="about-more__hint-text--mouse">psst&nbsp;… beweg mal die Maus hier!</span>
          <span class="about-more__hint-text--touch">psst&nbsp;… tipp mal irgendwo hin!</span>
        </p>
      </div>
      <div class="about-more__mobile" aria-hidden="true">
        <img src="/images/bilder-animation-trail/IMG_0534.JPG" alt="" />
        <img src="/images/bilder-animation-trail/IMG_1331.JPG" alt="" />
        <img src="/images/bilder-animation-trail/IMG_2600.JPG" alt="" />
        <img src="/images/bilder-animation-trail/IMG_8522.JPG" alt="" />
        <img src="/images/bilder-animation-trail/6cc8f6f9-b809-4a48-8163-3acb4727db0a.JPG" alt="" />
        <img src="/images/bilder-animation-trail/IMG_0559.JPG" alt="" />
        <img src="/images/bilder-animation-trail/IMG_6705.jpg" alt="" />
        <img src="/images/bilder-animation-trail/IMG_4082.JPG" alt="" />
        <img src="/images/bilder-animation-trail/FullSizeRender_2.jpg" alt="" />
      </div>
    </section>

    <Process />
    <Skills />
  </main>

  <Footer />
</BaseLayout>

<style>
  main :global(.case-hero__inner) {
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    align-items: start;
    padding-block: clamp(1rem, 3vw, 2rem) var(--section-spacing);
  }

  main :global(.case-hero__content) {
    padding-top: clamp(2rem, 5vw, 3.5rem);
  }

  main :global(.about-bio) {
    max-width: 60ch;
  }

  main :global(.about-media) {
    position: relative;
    aspect-ratio: auto;
    display: flex;
    justify-content: flex-end;
    align-items: flex-start;
    padding-top: clamp(2.5rem, 6vw, 5rem);
  }

  main :global(.polaroid) {
    margin: 0;
    padding: 1.1rem 1.1rem 5.5rem;
    background: #ffffff;
    box-shadow: 0 8px 32px rgba(28, 28, 28, 0.22);
    transform: rotate(1.5deg);
    max-width: 500px;
    width: 100%;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  main :global(.polaroid:hover) {
    transform: rotate(-1deg) translateY(-6px) scale(1.02);
    box-shadow: 0 22px 44px rgba(28, 28, 28, 0.28);
  }

  main :global(.polaroid img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center;
  }

  @media (max-width: 640px) {
    main :global(.case-hero__inner) {
      grid-template-columns: 1fr;
    }

    main :global(.about-media) {
      justify-content: center;
      padding-top: 0;
      margin-bottom: 1.75rem;
    }

    main :global(.polaroid) {
      max-width: 320px;
      transform: rotate(-1.5deg);
    }
  }

  @media (min-width: 641px) and (max-width: 1200px) {
    main :global(.case-hero__inner) {
      display: block;
    }

    main :global(.case-hero__content) {
      display: block;
      padding-top: clamp(2rem, 5vw, 3rem);
    }

    main :global(.case-hero__title) {
      font-size: clamp(2.75rem, 5vw, 3.75rem);
    }

    main :global(.about-media) {
      float: right;
      display: block;
      width: clamp(300px, 32vw, 400px);
      max-width: 45%;
      padding-top: 0;
      margin: 0.5rem 1rem 1rem 2rem;
      shape-outside: margin-box;
    }

    main :global(.polaroid) {
      max-width: 100%;
      transform: rotate(1.5deg);
    }

    main :global(.polaroid img) {
      aspect-ratio: 2 / 3;
    }

    main :global(.about-bio p) {
      margin: 0 0 0.75rem;
    }
  }

  @media (min-width: 1025px) and (max-width: 1200px) {
    main :global(.about-media) {
      margin-top: 2rem;
    }

    main :global(.case-hero__title) {
      font-size: clamp(2.4rem, 4vw, 3rem);
    }
  }

  @media (min-width: 901px) {
    main :global(.case-hero__inner) {
      display: block;
    }

    main :global(.case-hero__content) {
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) minmax(0, auto);
      column-gap: clamp(2rem, 4vw, 3rem);
      row-gap: 1.5rem;
      align-items: start;
      padding-top: clamp(2rem, 5vw, 3rem);
    }

    main :global(.case-hero__title) {
      grid-column: 1;
      grid-row: 1;
      margin-bottom: 0;
    }

    main :global(.about-bio) {
      grid-column: 1;
      grid-row: 2;
      max-width: 60ch;
    }

    main :global(.about-media) {
      grid-column: 2;
      grid-row: 1 / span 2;
      float: none !important;
      display: flex;
      justify-content: flex-end;
      align-items: flex-start;
      width: clamp(320px, 32vw, 440px);
      max-width: none;
      margin: 0;
      padding-top: 0.5rem;
      shape-outside: none !important;
    }

    main :global(.polaroid) {
      max-width: 100%;
      transform: rotate(1.5deg);
    }

    main :global(.polaroid img) {
      aspect-ratio: 2 / 3;
      height: auto;
    }
  }

  @media (max-width: 480px) {
    main :global(.polaroid) {
      max-width: 260px;
      padding: 0.6rem 0.6rem 3rem;
    }
  }

  main :global(.process) {
    padding-bottom: clamp(2rem, 5vw, 4rem);
  }

  /* "Mehr zu mir" – Weißraum als interaktive Spielfläche */
  .about-more {
    padding-bottom: 0;
  }

  .about-more__bg {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: var(--max-width);
    padding-inline: var(--gutter);
    z-index: 0;
    pointer-events: none;
  }

  .about-more__bg-img {
    position: absolute;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center;
    border: 7px solid #fff;
    border-bottom: 32px solid #fff;
    box-shadow: 0 6px 20px rgba(28, 28, 28, 0.15);
    opacity: 0.22;
  }

  .about-more__canvas {
    height: clamp(20rem, 60vh, 50rem);
    width: 100%;
    position: relative;
    overflow: hidden;
    clip-path: inset(0);
  }

  /* Mobile: statische Bildauswahl statt Trail */
  .about-more__mobile {
    display: none;
  }

  @media (hover: none) {
    .about-more__canvas {
      display: none;
    }

    .about-more__mobile {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.75rem;
      padding: 1.5rem var(--gutter) 2.5rem;
    }

    .about-more__mobile img {
      width: 100%;
      aspect-ratio: 4 / 5;
      object-fit: cover;
      border: 5px solid #fff;
      border-bottom: 22px solid #fff;
      box-shadow: 0 4px 14px rgba(28, 28, 28, 0.18);
      opacity: 0;
      transform: translateY(16px) scale(0.96);
      transition: opacity 0.5s ease, transform 0.5s ease;
    }

    .about-more__mobile.is-visible img {
      opacity: 1;
      transform: none;
    }

    .about-more__mobile.is-visible img:nth-child(1) { transition-delay: 0ms; }
    .about-more__mobile.is-visible img:nth-child(2) { transition-delay: 60ms; }
    .about-more__mobile.is-visible img:nth-child(3) { transition-delay: 120ms; }
    .about-more__mobile.is-visible img:nth-child(4) { transition-delay: 180ms; }
    .about-more__mobile.is-visible img:nth-child(5) { transition-delay: 240ms; }
    .about-more__mobile.is-visible img:nth-child(6) { transition-delay: 300ms; }
    .about-more__mobile.is-visible img:nth-child(7) { transition-delay: 360ms; }
    .about-more__mobile.is-visible img:nth-child(8) { transition-delay: 420ms; }
    .about-more__mobile.is-visible img:nth-child(9) { transition-delay: 480ms; }
  }

  /* Polaroid-Stil: einheitliche Größe, quadratischer Bildausschnitt */
  .about-more__canvas :global(.trail-img) {
    width: clamp(130px, 12vw, 170px);
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center;
    border: 8px solid #fff;
    border-bottom: 36px solid #fff;
    box-shadow: 0 8px 28px rgba(28, 28, 28, 0.22);
  }

  .about-more__hint {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: 'Reenie Beanie', cursive;
    font-size: 2.4rem;
    line-height: 1;
    color: var(--color-sage-dark);
    transform: rotate(-3deg);
    opacity: 0;
    animation: about-hint-in 0.8s ease 0.6s forwards;
    transition: opacity 0.6s ease;
    pointer-events: none;
    z-index: 10;
  }

  .about-more__canvas.hint-done .about-more__hint {
    animation: none;
    opacity: 0;
  }

  .about-more__hint-text--touch { display: none; }

  @media (hover: none) {
    .about-more__hint-text--mouse { display: none; }
    .about-more__hint-text--touch { display: inline; }
  }

  @keyframes about-hint-in {
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-more__hint { display: none; }
  }

</style>

<script>
  function initHintFade() {
    const canvas = document.querySelector<HTMLElement>('.about-more__canvas');
    if (!canvas) return;

    const allImages = (canvas.dataset.trail ?? '').split('|').filter(Boolean);
    const bgImgs = Array.from(canvas.querySelectorAll<HTMLImageElement>('.about-more__bg-img'));

    function shuffleBgImages() {
      if (!bgImgs.length || !allImages.length) return;
      const pool = [...allImages].sort(() => Math.random() - 0.5);
      bgImgs.forEach((img, i) => { img.src = pool[i % pool.length]; });
    }

    function fadeHint() {
      const hint = canvas!.querySelector<HTMLElement>('.about-more__hint');
      if (!hint) return;
      const cur = parseFloat(getComputedStyle(hint).opacity);
      hint.style.opacity = String(cur);
      hint.style.animation = 'none';
      void hint.offsetHeight;
      hint.style.opacity = '0';
    }

    function resetHint() {
      const hint = canvas!.querySelector<HTMLElement>('.about-more__hint');
      if (!hint) return;
      hint.style.opacity = '';
      hint.style.animation = '';
    }

    let activeMo: MutationObserver | null = null;

    function watchLayer(l: HTMLElement) {
      activeMo?.disconnect();
      let count = 0;
      const mo = new MutationObserver((mutations) => {
        for (const m of mutations) {
          count += m.addedNodes.length;
          if (count >= 3) { fadeHint(); mo.disconnect(); activeMo = null; break; }
        }
      });
      mo.observe(l, { childList: true });
      activeMo = mo;
    }

    function setupWatcher() {
      const existing = canvas!.querySelector<HTMLElement>('.trail-layer');
      if (existing) {
        watchLayer(existing);
      } else {
        const obs = new MutationObserver(() => {
          const l = canvas!.querySelector<HTMLElement>('.trail-layer');
          if (l) { obs.disconnect(); watchLayer(l); }
        });
        obs.observe(canvas!, { childList: true });
      }
    }

    // Mobile: zufällige Bilder + Einblend-Animation
    const mobile = canvas.closest('section')?.querySelector<HTMLElement>('.about-more__mobile');
    const mobileImgs = mobile ? Array.from(mobile.querySelectorAll<HTMLImageElement>('img')) : [];

    function shuffleMobileImages() {
      if (!mobileImgs.length || !allImages.length) return;
      const pool = [...allImages].sort(() => Math.random() - 0.5);
      mobileImgs.forEach((img, i) => { img.src = pool[i % pool.length]; });
    }

    if (mobile) {
      const mio = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            mobile.classList.add('is-visible');
          } else {
            mobile.classList.remove('is-visible');
            shuffleMobileImages();
          }
        });
      }, { threshold: 0.1 });
      mio.observe(mobile);
      shuffleMobileImages();

      // Flip-Effekt bei Tap/Click (alle Geräte ohne Maus)
      if (window.matchMedia('(hover: none)').matches) {
        mobileImgs.forEach((img) => {
          img.style.cursor = 'pointer';
          img.addEventListener('click', () => {
            if (img.dataset.flipping) return;
            img.dataset.flipping = '1';

            img.style.transition = 'transform 0.2s ease-in';
            img.style.transform = 'rotateY(90deg)';

            img.addEventListener('transitionend', () => {
              const visibleSrcs = mobileImgs.map(el => el.getAttribute('src') ?? '');
              const pool = allImages.filter(s => !visibleSrcs.some(v => v === s || v.endsWith(s)));
              img.src = (pool.length ? pool : allImages)[Math.floor(Math.random() * (pool.length || allImages.length))];
              img.style.transition = 'transform 0.2s ease-out';
              img.style.transform = 'rotateY(0deg)';
              img.addEventListener('transitionend', () => {
                delete img.dataset.flipping;
              }, { once: true });
            }, { once: true });
          });
        });
      }
    }

    // Reset hint + neue Bilder wenn Section den Viewport verlässt
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) {
          resetHint();
          shuffleBgImages();
          setupWatcher();
        }
      });
    }, { threshold: 0 });

    io.observe(canvas);
    shuffleBgImages();
    setupWatcher();
  }

  document.addEventListener('astro:page-load', initHintFade);
</script>
