---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import CaseHero from '../../components/CaseHero.astro';
import CaseToc from '../../components/CaseToc.astro';
import TabCard from '../../components/TabCard.astro';
import LinkTile from '../../components/LinkTile.astro';
import Projects from '../../components/Projects.astro';
import Footer from '../../components/Footer.astro';

const overview = [
  { number: '1', label: 'Problemstellung', href: '#problemstellung' },
  { number: '2', label: 'Ergebnis', href: '#ergebnis' },
  { number: '3', label: 'Projekt-Details', href: '#projekt-details' },
  { number: '4', label: 'Ausschnitt des Prozesses', href: '#prozess' },
  { number: '5', label: 'Learnings', href: '#learnings' },
  { number: '6', label: 'Dokumentation & Link', href: '#download-link' },
];

const meta = ['4. Semester', 'Einzelarbeit', '2026'];

const processSteps = [
  {
    number: '1',
    title: 'Empathize',
    images: [
      { src: '/images/ernaehrungsberaterin/nutzungskontext/P1_Eichin_Emma_Webauftritt-Ernaehrungsberaterin_Seite_008.png', alt: 'Auszug aus der Dokumentation: Nutzungskontext, Seite 1' },
      { src: '/images/ernaehrungsberaterin/nutzungskontext/P1_Eichin_Emma_Webauftritt-Ernaehrungsberaterin_Seite_009.png', alt: 'Auszug aus der Dokumentation: Nutzungskontext, Seite 2' },
      { src: '/images/ernaehrungsberaterin/nutzungskontext/P1_Eichin_Emma_Webauftritt-Ernaehrungsberaterin_Seite_010.png', alt: 'Auszug aus der Dokumentation: Nutzungskontext, Seite 3' },
    ],
    bodyHtml: `<p>Zu Beginn des Projekts habe ich die zentralen <strong>W-Fragen</strong> beantwortet sowie den <strong>Nutzungskontext</strong>, die <strong>Zielgruppe</strong> und den <strong>Wettbewerb</strong> analysiert. Da diese ersten Erkenntnisse weitgehend auf Annahmen und Hypothesen basierten, dienten die anschließenden <strong>Interviews</strong> und <strong>Umfragen</strong> dazu, diese zu überprüfen. Dadurch entstand ein fundiertes Bild der echten Nutzerbedürfnisse, was die weitere Entwicklung maßgeblich vorangebracht hat.</p>
      <p>Um diesen Schritt greifbarer zu machen, findest du auf der rechten Seite einen Auszug aus meiner Dokumentation zum Nutzungskontext. Für die vollständige Ansicht kannst du das Bild anklicken.</p>`,
  },
  {
    number: '2',
    title: 'Define',
    images: [
      { src: '/images/ernaehrungsberaterin/persona/P1_Eichin_Emma_Webauftritt-Ernaehrungsberaterin_Seite_035.png', alt: 'Persona-Übersicht' },
      { src: '/images/ernaehrungsberaterin/persona/P1_Eichin_Emma_Webauftritt-Ernaehrungsberaterin_Seite_036.png', alt: 'Primärpersona Sophie' },
      { src: '/images/ernaehrungsberaterin/persona/P1_Eichin_Emma_Webauftritt-Ernaehrungsberaterin_Seite_037.png', alt: 'Persona Details' },
      { src: '/images/ernaehrungsberaterin/persona/P1_Eichin_Emma_Webauftritt-Ernaehrungsberaterin_Seite_038.png', alt: 'Weitere Persona-Analyse' },
    ],
    bodyHtml: `<p>Auf Basis der Research-Ergebnisse folgte die Define-Phase, um noch tiefer in die tatsächlichen Nutzerbedürfnisse einzutauchen. Mithilfe von <strong>Personas</strong>, <strong>Use Cases</strong> und <strong>Jobs-to-be-Done</strong> habe ich die Anforderungen der NutzerInnen konkretisiert. Ergänzt durch eine <strong>User Journey Map</strong> und ein klares <strong>Mission Statement</strong> entstand so das Fundament für die Konzeption der Website.</p>
      <p>Exemplarisch findest du auf der rechten Seite die Primärpersona Sophie, die ich für diese Phase entwickelt habe. Ein Klick auf das Bild zeigt sie in voller Größe.</p>`,
  },
  {
    number: '3',
    title: 'Ideate',
    images: [
      { src: '/images/ernaehrungsberaterin/zielgruppengerechtes%20Design/P1_Eichin_Emma_Webauftritt-Ernaehrungsberaterin_Seite_055.png', alt: 'Ausgearbeitete Designanforderungen' },
      { src: '/images/ernaehrungsberaterin/zielgruppengerechtes%20Design/P1_Eichin_Emma_Webauftritt-Ernaehrungsberaterin_Seite_056.png', alt: 'Weitere Designanforderungen' },
    ],
    bodyHtml: `<p>Anschließend ging es darum, die konkreten <strong>Designanforderungen</strong> für die Zielgruppe abzuleiten. Neben der <strong>Informationsarchitektur</strong> habe ich dafür klare <strong>Richtlinien</strong> und <strong>Gestaltungsprinzipien</strong> aufgestellt, welche als Leitfaden für die Konzeption der Website dienten.</p>
      <p>Als konkretes Beispiel findest du auf der rechten Seite die ausgearbeiteten Designanforderungen. Klick aufs Bild für die Detailansicht.</p>`,
  },
  {
    number: '4',
    title: 'Prototype',
    images: [
      { src: '/images/ernaehrungsberaterin/style/P1_Eichin_Emma_Webauftritt-Ernaehrungsberaterin_Seite_071.png', alt: 'Einblick in den Styleguide, Seite 1' },
      { src: '/images/ernaehrungsberaterin/style/P1_Eichin_Emma_Webauftritt-Ernaehrungsberaterin_Seite_072.png', alt: 'Einblick in den Styleguide, Seite 2' },
      { src: '/images/ernaehrungsberaterin/style/P1_Eichin_Emma_Webauftritt-Ernaehrungsberaterin_Seite_073.png', alt: 'Einblick in den Styleguide, Seite 3' },
      { src: '/images/ernaehrungsberaterin/style/P1_Eichin_Emma_Webauftritt-Ernaehrungsberaterin_Seite_074.png', alt: 'Einblick in den Styleguide, Seite 4' },
      { src: '/images/ernaehrungsberaterin/style/P1_Eichin_Emma_Webauftritt-Ernaehrungsberaterin_Seite_075.png', alt: 'Einblick in den Styleguide, Seite 5' },
    ],
    bodyHtml: `<p>Für ein konsistentes Erscheinungsbild habe ich einen <strong>Styleguide</strong> definiert. Da die Website für den echten Live-Betrieb gedacht ist, habe ich zudem erste Maßnahmen zur <strong>SEO-Optimierung</strong> berücksichtigt.</p>
      <p>Auf der rechten Seite findest du einen Ausschnitt aus dem Styleguide, der diese Phase veranschaulicht. Die vollständige Ansicht bekommst du per Klick aufs Bild.</p>`,
  },
  {
    number: '5',
    title: 'Testing',
    images: [
      { src: '/images/ernaehrungsberaterin/test/P1_Eichin_Emma_Webauftritt-Ernaehrungsberaterin_Seite_092.png', alt: 'Auszug aus der Dokumentation: UEQ-Test, Seite 1' },
      { src: '/images/ernaehrungsberaterin/test/P1_Eichin_Emma_Webauftritt-Ernaehrungsberaterin_Seite_093.png', alt: 'Auszug aus der Dokumentation: UEQ-Test, Seite 2' },
    ],
    bodyHtml: `<p>Während des gesamten Prozesses wurden regelmäßig <strong>Thinking-Aloud-Tests</strong> durchgeführt, um Schwachstellen frühzeitig zu erkennen und die Website fortlaufend zu verbessern. Zum Abschluss lieferte ein <strong>UEQ-Test</strong> noch einmal wertvolle Erkenntnisse über die tatsächliche Nutzererfahrung.</p>
      <p>Als konkretes Beispiel für diesen Schritt findest du auf der rechten Seite einen Einblick in den durchgeführten UEQ-Test. Ein Klick vergrößert den Ausschnitt.</p>`,
  },
];

const learningsHtml = `Das Projekt bot eine ideale Gelegenheit, den Einsatz von KI realistisch zu evaluieren. Während <strong>Claude</strong> beim zügigen Aufsetzen von Grundstrukturen und Entwürfen eine echte Beschleunigung war, zeigte sich bei kleineren Detailanpassungen die Kehrseite: Häufig waren zeitraubende <strong>Prompt-Iterationen</strong> erforderlich, um das gewünschte Ergebnis präzise zu treffen. Daher kann ich mir für <strong>zukünftige Projekte</strong> eine <strong>Kombination aus Figma und KI-Werkzeugen</strong> gut vorstellen.`;

const VIDEO_DIR = '/video/ernaehrungsberatung';

const ergebnisse = [
  {
    idx: '01',
    title: 'Startseite',
    kategorie: 'Website',
    jahr: '2026',
    video: `${VIDEO_DIR}/home.mp4`,
    videoAlt: 'Vorschau-Video der Startseite',
    kontext: 'Die Startseite vermittelt einen ersten Eindruck von Sonjas Beratungsangebot. Durch den gezielten Einsatz von Information Hiding werden Inhalte schrittweise offengelegt, sodass BesucherInnen ruhig in das Angebot geführt werden, ohne von der Informationsdichte überfordert zu werden.',
  },
  {
    idx: '02',
    title: 'Leistungen',
    kategorie: 'Website',
    jahr: '2026',
    video: `${VIDEO_DIR}/leistungen.mp4`,
    videoAlt: 'Vorschau-Video der Leistungsübersicht',
    kontext: 'Mit einem Klick auf „Leistungen" bekommen InteressentInnen zunächst einen groben Überblick über das gesamte Leistungsangebot und können sich anschließend gezielt zum passenden Angebot näher informieren.',
  },
  {
    idx: '03',
    title: 'Privatperson',
    kategorie: 'Website',
    jahr: '2026',
    video: `${VIDEO_DIR}/privatperson.mp4`,
    videoAlt: 'Vorschau-Video: Angebot für Privatpersonen',
    kontext: 'Das Angebot für Privatpersonen wird nach Schwerpunkten sortiert vorgestellt — per Klick auf einen Schwerpunkt können sich Interessierte näher informieren.',
  },
  {
    idx: '04',
    title: 'Unternehmen',
    kategorie: 'Website',
    jahr: '2026',
    video: `${VIDEO_DIR}/unternehmen.mp4`,
    videoAlt: 'Vorschau-Video: Angebot für Unternehmen',
    kontext: 'Für Unternehmen bündelt die Seite alle Informationen übersichtlich an einem Ort.',
  },
  {
    idx: '05',
    title: 'Über mich',
    kategorie: 'Website',
    jahr: '2026',
    video: `${VIDEO_DIR}/uebermich.mp4`,
    videoAlt: 'Vorschau-Video der Über-mich-Seite',
    kontext: 'Auf der Über-mich-Seite lernen NutzerInnen Sonja persönlich kennen — von Werdegang und Qualifikationen über Referenzen und Beratungsansatz bis hin zu ihren Mitgliedschaften.',
  },
  {
    idx: '06',
    title: 'Kontakt',
    kategorie: 'Website',
    jahr: '2026',
    video: `${VIDEO_DIR}/kontakt.mp4`,
    videoAlt: 'Vorschau-Video der Kontaktseite',
    kontext: 'Die Kontaktseite bündelt alle Wege der Terminvereinbarung und senkt so die Hürde für eine erste Anfrage.',
  },
];

---

<BaseLayout
  title="Website für eine Ernährungsberaterin - Emma Eichin"
  description="Case Study: Konzeption und Umsetzung der ersten Webpräsenz für die Ernährungsberaterin Sonja Eichin — UI/UX-Design, 4. Semester."
>
  <Header />
  <main>
    <CaseHero
      title="Website für eine Ernährungsberaterin"
      meta={meta}
      image="/images/voschau%20projektsseiten/neu/ernaehrungsbild.png"
      imageAlt="Vorschau der Website für Sonja Eichin"
    />

    <CaseToc items={overview} />

    <section id="problemstellung" class="section">
      <div class="wrapper">
        <h2 class="section-heading" data-reveal>Problemstellung</h2>
        <TabCard tab="Ausgangspunkt" data-reveal>
          <p class="tab-card__text">
            Für die Ernährungsberaterin Sonja Eichin existierte <strong>bislang kein digitaler Auftritt</strong>, wodurch es an Sichtbarkeit im Netz und einer repräsentativen Plattform fehlte. Um diese Lücke zu schließen, wurde ihre <strong>erste Webpräsenz</strong> von Grund auf neu <strong>konzipiert</strong> und realisiert.
          </p>
        </TabCard>
      </div>
    </section>

    <section id="ergebnis" class="section">
      <div class="wrapper">
        <h2 class="section-heading" data-reveal>Ergebnis</h2>
      </div>

      {ergebnisse.map((w, i) => (
        <div class="wrapper deck-slide" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
          <div class="deck-slide__num">{w.idx}</div>
          <div class="deck-slide__content">
            <h3 class="deck-slide__title">{w.title}</h3>
            <div class="deck-slide__video" aria-label={w.videoAlt}>
              <video
                src={w.video}
                muted
                loop
                playsinline
                preload="metadata"
                aria-label={w.videoAlt}
                data-restart-on-view
              ></video>
            </div>
            <p class="deck-slide__body">{w.kontext}</p>
          </div>
        </div>
      ))}
    </section>

    <section id="projekt-details" class="section">
      <div class="wrapper">
        <h2 class="section-heading" data-reveal>Projekt-Details</h2>

        <TabCard tab="Fokus" data-reveal>
          <p class="tab-card__text">
            Der Schwerpunkt dieser Arbeit lag auf der <strong>Konzeption der Website</strong>. Um das Potenzial sowie die Limitationen künstlicher Intelligenz im Entwicklungsprozess zu untersuchen, wurde ein <strong>rein KI-basierter Workflow</strong> gewählt. Die technische Umsetzung erfolgte im Sinne des sogenannten &bdquo;<strong>Vibe-Codings</strong>&ldquo;, wodurch der Fokus gezielt auf die methodische Ausarbeitung und Konzeption gelenkt werden konnte.
          </p>
        </TabCard>

        <TabCard tab="Methodische Grundlage" data-reveal style="--reveal-delay: 100ms">
          <img
            class="tab-card__top-image"
            src="/images/ernaehrungsberaterin/METHODE-v2.png"
            alt="Design-Thinking-Prozess: Empathize, Define, Ideate, Prototype, Test"
            width="1920"
            height="550"
            loading="lazy"
            style="border: none; width: 100%; max-width: 560px; margin: 0 auto 2.25rem; height: auto;"
          />
          <p class="tab-card__text">
            Die Arbeit stützte sich methodisch auf den <strong>Design-Thinking-Prozess der Stanford d.school</strong>. Dessen phasenbasierter Ansatz erlaubte es, tiefgehende Einblicke in die Lebensrealität und Anforderungen der Zielgruppe zu gewinnen.
          </p>
        </TabCard>
      </div>
    </section>

    <section id="prozess" class="section">
      <div class="wrapper">
        <h2 class="section-heading" data-reveal>Ausschnitt des Prozesses</h2>

        {processSteps.map((step, i) => (
          <div class="prozess-step" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
            <TabCard tab={`${step.number} ${step.title}`}>
              <div class="tab-card__text" set:html={step.bodyHtml} />
            </TabCard>
            {step.images && step.images.length > 0 && (
              <button
                type="button"
                class="prozess-step__thumb"
                data-images={JSON.stringify(step.images)}
                aria-label={`Bilder zu ${step.title} öffnen`}
              >
                <img
                  class="prozess-step__image"
                  src={step.images[0].src}
                  alt={step.images[0].alt}
                  loading="lazy"
                />
                {step.images.length > 1 && (
                  <span class="prozess-step__badge">+{step.images.length - 1}</span>
                )}
              </button>
            )}
          </div>
        ))}
      </div>
    </section>

    <section id="learnings" class="section">
      <div class="wrapper">
        <h2 class="section-heading" data-reveal>Learnings</h2>
        <TabCard tab="Erkenntnisse" data-reveal>
          <div class="tab-card__text" set:html={`<p>${learningsHtml}</p>`} />
        </TabCard>
      </div>
    </section>

    <section id="download-link" class="section">
      <div class="wrapper">
        <h2 class="section-heading" data-reveal>Dokumentation &amp; Link</h2>

        <div class="download-grid">
          <TabCard tab="Dokumentation" data-reveal>
            <p class="tab-card__text">Die vollständige Dokumentation zum Projekt kannst du hier ansehen.</p>
            <LinkTile
              href="/dokumente/Projekt-Dokumentation.pdf"
              title="Projekt-Dokumentation ansehen"
              subtitle="PDF | 104 Seiten"
              icon="external"
              target="_blank"
            />
          </TabCard>

          <TabCard tab="Link" data-reveal>
            <p class="tab-card__text">Die Website steht kurz vor der Veröffentlichung. Sobald sie live ist, gelangst du an dieser Stelle direkt zum Ergebnis.</p>
          </TabCard>
        </div>
      </div>
    </section>

    <Projects excludeHref="/projekte/website-ernährungsberatung" heading="Weitere Projekte" id="weitere-projekte" />
  </main>

  <div class="lightbox" id="lightbox" hidden role="dialog" aria-modal="true" aria-label="Bildergalerie">
    <button type="button" class="lightbox__close" aria-label="Schließen">×</button>
    <button type="button" class="lightbox__nav lightbox__nav--prev" aria-label="Vorheriges Bild">‹</button>
    <figure class="lightbox__figure">
      <img class="lightbox__image" alt="" />
      <figcaption class="lightbox__counter"></figcaption>
    </figure>
    <button type="button" class="lightbox__nav lightbox__nav--next" aria-label="Nächstes Bild">›</button>
  </div>

  <script>
    const lightbox = document.getElementById('lightbox');
    if (lightbox) {
      const imgEl = lightbox.querySelector('.lightbox__image') as HTMLImageElement;
      const counterEl = lightbox.querySelector('.lightbox__counter') as HTMLElement;
      const prevBtn = lightbox.querySelector('.lightbox__nav--prev') as HTMLButtonElement;
      const nextBtn = lightbox.querySelector('.lightbox__nav--next') as HTMLButtonElement;
      const closeBtn = lightbox.querySelector('.lightbox__close') as HTMLButtonElement;

      let images: { src: string; alt: string }[] = [];
      let index = 0;

      const render = () => {
        if (!images[index]) return;
        imgEl.src = images[index].src;
        imgEl.alt = images[index].alt;
        counterEl.textContent = `${index + 1} / ${images.length}`;
        const multi = images.length > 1;
        prevBtn.hidden = !multi;
        nextBtn.hidden = !multi;
      };

      const open = (imgs: typeof images, startIdx: number) => {
        images = imgs;
        index = startIdx;
        render();
        lightbox.hidden = false;
        document.body.style.overflow = 'hidden';
      };

      const close = () => {
        lightbox.hidden = true;
        document.body.style.overflow = '';
      };

      const prev = () => {
        index = (index - 1 + images.length) % images.length;
        render();
      };

      const next = () => {
        index = (index + 1) % images.length;
        render();
      };

      document.querySelectorAll<HTMLButtonElement>('.prozess-step__thumb').forEach((btn) => {
        btn.addEventListener('click', () => {
          try {
            const list = JSON.parse(btn.dataset.images || '[]');
            if (Array.isArray(list) && list.length) open(list, 0);
          } catch {}
        });
      });

      closeBtn.addEventListener('click', close);
      prevBtn.addEventListener('click', prev);
      nextBtn.addEventListener('click', next);

      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) close();
      });

      document.addEventListener('keydown', (e) => {
        if (lightbox.hidden) return;
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowLeft') prev();
        else if (e.key === 'ArrowRight') next();
      });

      let touchStartX = 0;
      imgEl.addEventListener('touchstart', (e) => {
        touchStartX = e.touches[0].clientX;
      }, { passive: true });
      imgEl.addEventListener('touchend', (e) => {
        const diff = e.changedTouches[0].clientX - touchStartX;
        if (Math.abs(diff) > 50) diff > 0 ? prev() : next();
      });
    }

    const restartVideos = document.querySelectorAll<HTMLVideoElement>('video[data-restart-on-view]');
    if (restartVideos.length && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const v = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            try { v.currentTime = 0; } catch {}
            v.play().catch(() => {});
          } else {
            v.pause();
          }
        });
      }, { threshold: 0.5 });
      restartVideos.forEach((v) => io.observe(v));
    }

    restartVideos.forEach((video) => {
      const parent = video.parentElement;
      if (!parent || parent.classList.contains('video-player')) return;
      parent.classList.add('video-player');

      const iconPlay = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';
      const iconPause = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>';

      const controls = document.createElement('div');
      controls.className = 'video-player__controls';
      controls.innerHTML = `
        <button type="button" class="video-player__btn" data-action="play" aria-label="Abspielen oder Pausieren">${iconPlay}</button>
        <div class="video-player__progress" role="slider" aria-label="Video-Fortschritt" tabindex="0">
          <div class="video-player__progress-fill"></div>
          <div class="video-player__progress-handle"></div>
        </div>
      `;
      parent.appendChild(controls);

      const playBtn = controls.querySelector('[data-action="play"]') as HTMLButtonElement;
      const fill = controls.querySelector('.video-player__progress-fill') as HTMLElement;
      const handle = controls.querySelector('.video-player__progress-handle') as HTMLElement;
      const progress = controls.querySelector('.video-player__progress') as HTMLElement;

      const syncPlayIcon = () => {
        playBtn.innerHTML = video.paused ? iconPlay : iconPause;
        playBtn.setAttribute('aria-label', video.paused ? 'Abspielen' : 'Pausieren');
      };
      syncPlayIcon();

      let hideTimer: number | undefined;
      const showControls = () => {
        parent.classList.add('is-controls-visible');
        if (hideTimer !== undefined) {
          window.clearTimeout(hideTimer);
          hideTimer = undefined;
        }
      };
      const scheduleHide = () => {
        if (hideTimer !== undefined) window.clearTimeout(hideTimer);
        hideTimer = window.setTimeout(() => {
          parent.classList.remove('is-controls-visible');
          hideTimer = undefined;
        }, 1000);
      };
      parent.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'touch') showControls();
      });
      parent.addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'touch') showControls();
      });
      parent.addEventListener('pointerleave', (e) => {
        if (e.pointerType !== 'touch') scheduleHide();
      });
      parent.addEventListener('pointerdown', (e) => {
        if (e.pointerType === 'touch') {
          showControls();
          scheduleHide();
        }
      });

      playBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (video.paused) video.play().catch(() => {});
        else video.pause();
      });
      video.addEventListener('play', syncPlayIcon);
      video.addEventListener('pause', syncPlayIcon);
      video.addEventListener('timeupdate', () => {
        if (!video.duration) return;
        const pct = (video.currentTime / video.duration) * 100;
        fill.style.width = pct + '%';
        handle.style.left = pct + '%';
      });

      const seek = (clientX: number) => {
        if (!video.duration) return;
        const rect = progress.getBoundingClientRect();
        const pct = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
        video.currentTime = pct * video.duration;
      };
      let dragging = false;
      progress.addEventListener('pointerdown', (e) => {
        dragging = true;
        seek(e.clientX);
        try { progress.setPointerCapture(e.pointerId); } catch {}
      });
      progress.addEventListener('pointermove', (e) => {
        if (dragging) seek(e.clientX);
      });
      const endDrag = (e: PointerEvent) => {
        dragging = false;
        try { progress.releasePointerCapture(e.pointerId); } catch {}
      };
      progress.addEventListener('pointerup', endDrag);
      progress.addEventListener('pointercancel', endDrag);
    });
  </script>

  <Footer />
</BaseLayout>

