---
const skills = [
  'Figma',
  'Illustrator',
  'InDesign',
  'Photoshop',
  'HTML, CSS, JS Basics',
  'Claude',
  'ChatGPT',
  'Gemini',
  '10-Finger-System',
];
const track = [...skills, ...skills];
---

<section class="section skills">
  <div class="wrapper">
    <h2 class="section-heading" data-split>Meine Kompetenzen</h2>

    <div
      class="skills-marquee"
      data-cursor="drag"
      data-cursor-label="swipe!"
      data-reveal
      style="--reveal-delay: 80ms"
      aria-label="Kompetenzen — automatisches Laufband, per Drag manuell scrollbar"
    >
      <ul class="skills-marquee__track">
        {track.map((skill, i) => (
          <li class="skills__chip" aria-hidden={i >= skills.length ? 'true' : undefined}>
            <span class="skills__chip-label">{skill}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .skills-marquee {
    overflow: hidden;
    padding-block: 1.25rem 1.75rem;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }

  .skills-marquee.is-grabbing {
    cursor: grabbing;
  }

  .skills-marquee__track {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .skills__chip {
    position: relative;
    display: inline-block;
    isolation: isolate;
    flex-shrink: 0;
    margin-right: clamp(1.5rem, 3vw, 2.25rem);
  }

  .skills__chip-label {
    position: relative;
    display: block;
    border: 1px solid var(--color-sage);
    background: #ffffff;
    color: var(--color-ink);
    font-weight: 700;
    font-size: 0.95rem;
    text-align: center;
    padding: 0.9rem 2rem;
    min-width: 9rem;
    z-index: 1;
    transition: transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1);
    transform-origin: center center;
    pointer-events: none;
  }

  .skills__chip::before {
    content: '';
    position: absolute;
    top: 12px;
    left: -6px;
    right: 14px;
    bottom: -6px;
    background: var(--color-sage-tint);
    z-index: 0;
    transition: transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1);
    pointer-events: none;
  }

  @media (hover: hover) {
    .skills-marquee:not(.is-grabbing) .skills__chip:hover .skills__chip-label {
      transform: rotate(-2deg) translateY(-2px);
    }

    .skills-marquee:not(.is-grabbing) .skills__chip:hover::before {
      transform: translate(-4px, 4px);
    }
  }

  @media (max-width: 640px) {
    .skills__chip {
      margin-right: 1.25rem;
    }

    .skills__chip-label {
      min-width: 0;
      padding: 0.85rem 1.25rem;
      font-size: 0.85rem;
      white-space: nowrap;
    }
  }
</style>

<script>
  // Laufband: läuft von selbst, lässt sich ziehen (Maus/Touch) und per
  // Trackpad-Swipe bzw. Shift+Mausrad bewegen. Alles läuft weich nach (Lerp).
  const initSkillsMarquee = () => {
    const marquee = document.querySelector<HTMLElement>('.skills-marquee');
    const track = marquee?.querySelector<HTMLElement>('.skills-marquee__track');
    if (!marquee || !track) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const SPEED = 0.5; // Autoplay in px pro Frame (~30 px/s)
    const EASE = prefersReducedMotion ? 1 : 0.1; // wie weich es nachläuft
    const RESUME_DELAY = 1400; // ms bis Autoplay nach Interaktion weiterläuft
    const FLING = 14; // Schwung nach dem Loslassen

    let halfWidth = 0;
    let offset = 0; // dargestellte Position
    let target = 0; // Zielposition, offset läuft weich hinterher
    let hovered = false;
    let dragging = false;
    let dragStartX = 0;
    let dragStartTarget = 0;
    let lastX = 0;
    let lastT = 0;
    let velocity = 0;
    let activePointer: number | null = null;
    let lastInteraction = 0;

    const measure = () => {
      halfWidth = track.scrollWidth / 2;
    };

    // Endlos-Schleife: offset und target gemeinsam verschieben,
    // damit der Abstand (und damit die Bewegung) erhalten bleibt
    const wrap = () => {
      if (halfWidth <= 0) return;
      while (offset <= -halfWidth) {
        offset += halfWidth;
        target += halfWidth;
      }
      while (offset > 0) {
        offset -= halfWidth;
        target -= halfWidth;
      }
    };

    const render = () => {
      wrap();
      track.style.transform = `translate3d(${offset.toFixed(2)}px, 0, 0)`;
    };

    measure();
    render();
    window.addEventListener('resize', () => {
      measure();
      render();
    });
    (document as any).fonts?.ready?.then?.(() => {
      measure();
      render();
    });

    const step = () => {
      const now = performance.now();
      const canAutoplay =
        !prefersReducedMotion && !hovered && !dragging && now - lastInteraction > RESUME_DELAY;

      if (canAutoplay) target -= SPEED;
      offset += (target - offset) * EASE;
      if (Math.abs(target - offset) < 0.01) offset = target;
      render();
      requestAnimationFrame(step);
    };
    requestAnimationFrame(step);

    marquee.addEventListener('mouseenter', () => { hovered = true; });
    marquee.addEventListener('mouseleave', () => { hovered = false; });

    // ---- Trackpad-Swipe / Shift + Mausrad ----
    marquee.addEventListener(
      'wheel',
      (e) => {
        const unit = e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? window.innerWidth : 1;
        let dx = e.deltaX * unit;
        if (e.shiftKey && dx === 0) dx = e.deltaY * unit;
        // Nur horizontale Gesten abfangen, vertikal scrollt die Seite normal weiter
        if (Math.abs(dx) <= Math.abs(e.deltaY * unit) && !e.shiftKey) return;
        e.preventDefault();
        target -= dx;
        lastInteraction = performance.now();
      },
      { passive: false }
    );

    // ---- Ziehen mit Maus / Finger ----
    marquee.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      dragging = true;
      activePointer = e.pointerId;
      dragStartX = e.clientX;
      dragStartTarget = target;
      lastX = e.clientX;
      lastT = performance.now();
      velocity = 0;
      marquee.classList.add('is-grabbing');
      try { marquee.setPointerCapture(e.pointerId); } catch {}
      lastInteraction = performance.now();
      e.preventDefault();
    });

    marquee.addEventListener('pointermove', (e) => {
      if (!dragging || e.pointerId !== activePointer) return;
      const now = performance.now();
      const dt = Math.max(1, now - lastT);
      velocity = velocity * 0.6 + ((e.clientX - lastX) / dt) * 16 * 0.4; // px pro Frame
      lastX = e.clientX;
      lastT = now;
      target = dragStartTarget + (e.clientX - dragStartX);
      lastInteraction = now;
    });

    const endDrag = (e: PointerEvent) => {
      if (!dragging) return;
      if (activePointer !== null && e.pointerId !== activePointer) return;
      dragging = false;
      activePointer = null;
      marquee.classList.remove('is-grabbing');
      // Schwung mitnehmen, wenn kurz vor dem Loslassen noch bewegt wurde
      if (performance.now() - lastT < 80) target += velocity * FLING;
      lastInteraction = performance.now();
    };
    marquee.addEventListener('pointerup', endDrag);
    marquee.addEventListener('pointercancel', endDrag);
    marquee.addEventListener('lostpointercapture', endDrag);
  };

  document.addEventListener('astro:page-load', initSkillsMarquee);
</script>
