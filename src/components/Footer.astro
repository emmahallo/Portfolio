---
const jahr = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrapper site-footer__grid">
    <div class="site-footer__col site-footer__col--brand">
            <p class="site-footer__tag">Mediendesign-Studentin<br />Fokus UI/UX</p>
    </div>

    <div class="site-footer__col">
      <h3 class="site-footer__heading">Kontakt</h3>
      <ul class="site-footer__list">
        <li>
          <a href="mailto:emma.eichin@gmx.de">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="site-footer__icon">
              <rect x="3" y="5" width="18" height="14" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.6" />
              <path d="M3.5 6.5l8.5 6 8.5-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
            emma.eichin@gmx.de
          </a>
        </li>
        <li>
          <a href="https://www.linkedin.com/" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="site-footer__icon">
              <rect x="3" y="3" width="18" height="18" rx="2" fill="none" stroke="currentColor" stroke-width="1.6" />
              <circle cx="7.5" cy="7.75" r="1.15" fill="currentColor" />
              <path d="M6.5 10.5h2v7h-2zM11 10.5h2v1c.55-.7 1.4-1.2 2.5-1.2 1.9 0 3 1.2 3 3.4v3.8h-2v-3.4c0-1.1-.4-1.8-1.4-1.8s-1.6.7-1.6 1.8v3.4h-2z" fill="currentColor" />
            </svg>
            LinkedIn
          </a>
        </li>
      </ul>
    </div>

    <div class="site-footer__col">
      <h3 class="site-footer__heading">Rechtliches</h3>
      <ul class="site-footer__list">
        <li><a href="/impressum">Impressum</a></li>
        <li><a href="/datenschutz">Datenschutz</a></li>
      </ul>
    </div>
  </div>

  <div class="wrapper site-footer__bottom">
    <span class="site-footer__giant" data-split="chars">Emma Eichin.</span>
    <span class="site-footer__copy">&copy; {jahr} Emma Eichin</span>
  </div>
</footer>

<style>
  /* Footer liegt „unter“ der Seite und wird beim Scrollen aufgedeckt
     (main hat dafür z-index + Hintergrund, siehe global.css). */
  .site-footer {
    --footer-bg: var(--color-forest);
    --footer-fg: #eef1ec;
    --footer-muted: #a9b5aa;
    position: relative;
    z-index: 0;
    background: var(--footer-bg);
    color: var(--footer-fg);
    overflow: hidden;
  }

  @media (min-width: 641px) and (min-height: 640px) {
    .site-footer {
      position: sticky;
      bottom: 0;
    }
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    padding-block: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .site-footer__col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .site-footer__brand {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    letter-spacing: 0.04em;
    color: var(--footer-fg);
    line-height: 1;
  }

  .site-footer__tag {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--footer-muted);
    max-width: 28ch;
  }

  .site-footer__heading {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--footer-muted);
  }

  .site-footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .site-footer__list a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.95rem;
    color: var(--footer-fg);
    text-decoration: none;
    transition: color 0.25s ease, transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-footer__list a:hover {
    color: #ffffff;
    transform: translateX(4px);
  }

  .site-footer__icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: var(--footer-muted);
  }

  .site-footer__bottom {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-bottom: 1.5rem;
  }

  .site-footer__giant {
    display: block;
    font-family: var(--font-display);
    font-size: 21cqi; /* passt sich immer exakt an die Breite an */
    line-height: 0.85;
    letter-spacing: 0.02em;
    color: var(--footer-fg);
    white-space: nowrap;
  }

  .site-footer__copy {
    font-size: 0.75rem;
    color: var(--footer-muted);
  }

  @media (max-width: 900px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .site-footer__col--brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
