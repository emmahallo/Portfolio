---
const jahr = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrapper site-footer__grid">
    <div class="site-footer__col site-footer__col--brand">
      <span class="site-footer__brand">Emma Eichin</span>
      <p class="site-footer__tag">Mediendesign-Studentin<br />Fokus UI/UX</p>
    </div>

    <div class="site-footer__col">
      <h3 class="site-footer__heading">Kontakt</h3>
      <ul class="site-footer__list">
        <li>
          <a href="mailto:emma.eichin@gmx.de">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="site-footer__icon">
              <rect x="3" y="5" width="18" height="14" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.6" />
              <path d="M3.5 6.5l8.5 6 8.5-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
            emma.eichin@gmx.de
          </a>
        </li>
        <li>
          <a href="https://www.linkedin.com/" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="site-footer__icon">
              <rect x="3" y="3" width="18" height="18" rx="2" fill="none" stroke="currentColor" stroke-width="1.6" />
              <circle cx="7.5" cy="7.75" r="1.15" fill="currentColor" />
              <path d="M6.5 10.5h2v7h-2zM11 10.5h2v1c.55-.7 1.4-1.2 2.5-1.2 1.9 0 3 1.2 3 3.4v3.8h-2v-3.4c0-1.1-.4-1.8-1.4-1.8s-1.6.7-1.6 1.8v3.4h-2z" fill="currentColor" />
            </svg>
            LinkedIn
          </a>
        </li>
      </ul>
    </div>

    <div class="site-footer__col">
      <h3 class="site-footer__heading">Rechtliches</h3>
      <ul class="site-footer__list">
        <li><a href="/impressum">Impressum</a></li>
        <li><a href="/datenschutz">Datenschutz</a></li>
      </ul>
    </div>
  </div>

  <div class="wrapper site-footer__copyright">
    <span>&copy; {jahr} Emma Eichin</span>
  </div>
  <div class="site-footer__rule" aria-hidden="true"></div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .site-footer__col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .site-footer__brand {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    letter-spacing: 0.04em;
    color: var(--color-ink);
    line-height: 1;
  }

  .site-footer__tag {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-ink);
    max-width: 28ch;
  }

  .site-footer__heading {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--color-sage-dark);
  }

  .site-footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .site-footer__list a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.95rem;
    color: var(--color-ink);
    text-decoration: none;
    font-weight: 400;
    transition: color 0.2s ease, font-weight 0.2s ease;
  }

  .site-footer__list a:hover {
    color: var(--color-sage-dark);
    font-weight: 700;
  }

  .site-footer__icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: var(--color-sage-dark);
  }

  .site-footer__copyright {
    display: flex;
    justify-content: flex-start;
    padding-block: 0 1.25rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-ink);
  }

  .site-footer__rule {
    height: 1px;
    background: var(--color-border);
  }

  @media (max-width: 900px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .site-footer__col--brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
