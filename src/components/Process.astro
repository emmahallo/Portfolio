---
import TabCard from './TabCard.astro';

const steps = [
  {
    number: '01',
    title: 'Recherche vor Gestaltung',
    text: '<strong>Was gestaltet wird</strong>, ergibt sich aus dem, <strong>was gebraucht wird</strong>. Am Anfang steht deshalb die <strong>Analyse von Problem und Zielgruppe</strong>, welche mit etablierten UX-Methoden herausgearbeitet werden.',
  },
  {
    number: '02',
    title: 'Design',
    text: '<strong>Figma und KI-Werkzeuge</strong> helfen mir, <strong>Ideen</strong> und gesammelte Erkenntnisse <strong>schnell sichtbar</strong> zu machen. <strong>Je früher ein Entwurf greifbar ist</strong>, desto <strong>früher</strong> lässt er sich <strong>prüfen</strong>.',
  },
  {
    number: '03',
    title: 'Testing',
    text: '<strong>Ob eine Lösung funktioniert</strong>, zeigt sich erst <strong>in der Anwendung</strong>. Daher führe ich <strong>früh und wiederholt Tests</strong> durch, die dafür sorgen, dass die <strong>Nutzung am Ende reibungslos</strong> gelingt.',
  },
  {
    number: '04',
    title: 'Teamarbeit',
    text: '<strong>Gute Projekte entstehen selten allein</strong>. Ich arbeite <strong>gern im Team</strong> und setze dabei auf eine <strong>offene Kommunikation</strong>, um effizient miteinander zu arbeiten.',
  },
];
---

<section id="ueber-mich" class="section process">
  <div class="wrapper">
    <h2 class="section-heading" data-reveal>Meine Arbeitsweise</h2>

    <div class="process__grid">
      {steps.map((step, i) => (
        <TabCard tab={`${step.number} ${step.title}`} data-reveal style={`--reveal-delay: ${(i % 2) * 120}ms`}>
          <p class="tab-card__text" set:html={step.text} />
        </TabCard>
      ))}
    </div>
  </div>
</section>

<style>
  .process__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(2, auto);
    grid-auto-flow: column;
    gap: clamp(2rem, 3.5vw, 2.75rem) clamp(3rem, 6vw, 5rem);
    align-items: stretch;
  }

  .process__grid .tab-card + .tab-card {
    margin-top: 0;
  }

  .process__grid .tab-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .process__grid .tab-card :global(.tab-card__frame) {
    flex: 1;
  }

  .process__grid .tab-card__text {
    font-size: 0.95rem;
    line-height: 1.55;
    max-width: none;
  }

  .process__grid .tab-card__text :global(strong) {
    font-weight: 700;
    color: var(--color-ink);
  }

  @media (min-width: 761px) and (max-width: 1024px) {
    .process__grid {
      grid-template-rows: 1fr 1fr;
    }
  }

  @media (max-width: 760px) {
    .process__grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      grid-auto-flow: row;
      gap: 1.75rem;
    }
  }
</style>
