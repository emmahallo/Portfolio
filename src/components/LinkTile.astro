---
// Download-/Link-Kachel (z. B. PDF-Dokumentation, Live-Website).
// Styling zentral in global.css (.link-tile / .link-tile__*).

interface Props {
  href: string;
  title: string;
  subtitle: string;
  icon?: 'download' | 'external';
  download?: boolean;
  target?: '_blank';
}

const { href, title, subtitle, icon = 'external', download, target } = Astro.props;

const icons = {
  download: 'M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2',
  external: 'M14 5h5v5M19 5l-8 8M8 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-2',
};
---

<a class="link-tile" href={href} download={download} target={target} rel={target === '_blank' ? 'noopener' : undefined}>
  <span class="link-tile__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="20" height="20">
      <path d={icons[icon]} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
  <span class="link-tile__text">
    <span class="link-tile__title">{title}</span>
    <span class="link-tile__subtitle">{subtitle}</span>
  </span>
</a>
