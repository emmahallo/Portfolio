---
// "Übersicht"-Section einer Projekt-Unterseite: Überschrift + vertikale Timeline (Variante B).

import TocChip from './TocChip.astro';

interface Props {
  items: { number: string; label: string; href: string }[];
}

const { items } = Astro.props;
---

<section id="uebersicht" class="section case-toc">
  <div class="wrapper">
    <h2 class="section-heading" data-reveal>Übersicht</h2>
    <div class="case-toc__body">
      <div class="case-toc__track">
        <ul class="case-toc__list" data-toc-list>
          {items.map((item) => (
            <li>
              <TocChip number={item.number} label={item.label} href={item.href} />
            </li>
          ))}
        </ul>
      </div>
      <div class="case-toc__hint" aria-hidden="true">
        <span class="case-toc__hint-text">klickbar!</span>
        <span class="case-toc__hint-arrow" role="presentation"></span>
      </div>
    </div>
  </div>
</section>

<script>
  function initCaseToc() {
    const lists = Array.from(document.querySelectorAll<HTMLElement>('[data-toc-list]'));
    if (!lists.length) return;
    lists.forEach((l) => {
      l.style.setProperty('--toc-line-scale', '1');
      l.querySelectorAll('li').forEach((li) => li.classList.add('is-past'));
      const hint = l.closest('.case-toc__body')?.querySelector('.case-toc__hint');
      if (hint) hint.classList.add('is-visible');
    });
  }

  document.addEventListener('astro:page-load', initCaseToc);
</script>
