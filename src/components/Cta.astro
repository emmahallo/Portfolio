---
// Kontakt-Abschluss der Startseite: großer Satz + Button mit Pfeil (Variante 1).
---

<section id="kontakt" class="section cta">
  <div class="wrapper cta__inner">
    <div class="cta__text">
      <h2 class="cta__title">
        <span data-split="chars">Neugierig</span><br />
        <span data-split="chars" style="--split-delay: 200ms">geworden?</span>
      </h2>
      <p class="cta__sub" data-reveal style="--reveal-delay: 300ms">
        Du hast ein Projekt, eine Praktikumsstelle oder einfach eine Frage?
        Schreib mir – ich freu mich, von dir zu hören.
      </p>
    </div>

    <div class="cta__btn-wrap" data-reveal style="--reveal-delay: 200ms">
      <a class="cta__btn" href="mailto:emma.eichin@gmx.de">
        <span class="cta__btn-text">Schreib mir</span>
        <span class="cta__btn-arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M5 19L19 5M19 5H8M19 5V16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .cta__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(2rem, 5vw, 5rem);
    padding-block: clamp(2rem, 6vw, 5rem) clamp(1rem, 3vw, 2.5rem);
  }

  .cta__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    min-width: 0;
  }

  .cta__title {
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--color-ink);
    font-size: clamp(2.6rem, 8.5vw, 8.5rem);
    line-height: 0.92;
    letter-spacing: 0.03em;
  }

  .cta__sub {
    font-weight: 300;
    font-size: clamp(1.05rem, 1.2vw, 1.25rem);
    color: var(--color-ink);
    max-width: 46ch;
  }

  /* ---- Variante 1: großer Button mit Pfeil ---- */
  .cta__btn-wrap {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
  }

  .cta__btn-wrap::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-sage-tint);
    transform: translate(-10px, 10px);
    transition: transform 0.35s ease;
  }

  .cta__btn-wrap:hover::before {
    transform: translate(-13px, 13px);
  }

  .cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem 2rem;
    border: 1px solid var(--color-sage);
    background: #ffffff;
    color: var(--color-ink);
    text-decoration: none;
    position: relative;
    z-index: 1;
    transition: background 0.35s ease, color 0.35s ease, transform 0.35s ease;
  }

  .cta__btn-wrap:hover .cta__btn {
    background: var(--color-sage);
    color: #ffffff;
    transform: translateY(-2px);
  }

  .cta__btn-text {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: 0.06em;
    font-weight: 400;
    line-height: 1;
  }

  .cta__btn-arrow svg {
    width: clamp(28px, 3.5vw, 42px);
    height: clamp(28px, 3.5vw, 42px);
    transition: transform 0.35s ease;
  }

  .cta__btn-wrap:hover .cta__btn-arrow svg {
    transform: rotate(45deg);
  }

  @media (max-width: 760px) {
    .cta__inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .cta__btn-wrap {
      align-self: flex-end;
    }
  }
</style>
