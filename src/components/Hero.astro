---
---

<section class="hero" style="overflow-x: clip;">
  <div class="wrapper hero__inner">
    <div class="hero__content">
      <span class="eyebrow">
        <span class="eyebrow__dot" aria-hidden="true"></span>
        Schwerpunkt UI/UX-Design
      </span>

      <h1 class="hero__title">
        Hey, ich bin<br />
        Emma Eichin!
      </h1>

      <p class="hero__text">
        Aktuell studiere ich im 5. Semester Mediendesign an der RWU Weingarten.
      </p>

      <div class="hero__actions">
        <a href="/projekte" class="btn btn--primary">Zu meinen Projekten</a>
        <a href="#ueber-mich" class="btn btn--outline">Über mich</a>
      </div>
    </div>

    <div class="hero__media">
      <div class="hero__shape" aria-hidden="true"></div>
      <img
        class="hero__photo"
        src="/images/Portrait/emma.png"
        width="900"
        height="1000"
        alt="Porträtfoto von Emma Eichin"
      />
    </div>
  </div>
</section>

<style>
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    padding-block: clamp(2rem, 6vw, 4rem) var(--section-spacing);
  }

  .hero__content {
    padding-top: clamp(4rem, 9vw, 7rem);
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero__content .eyebrow {
    margin-bottom: 1.75rem;
  }

  .hero__title {
    margin-bottom: 1rem;
  }

  .hero__text {
    margin-bottom: 1.75rem;
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--color-ink);
    font-size: clamp(2.5rem, 5.2vw, 4rem);
    letter-spacing: 0.07em;
    line-height: 1.05;
  }

  .hero__text {
    font-weight: 300;
    font-size: 1.25rem;
    color: var(--color-text);
    max-width: 34ch;
  }

  .hero .eyebrow {
    font-size: 1rem;
  }

  .hero__actions .btn {
    font-size: 1.0625rem;
  }

  .hero__actions .btn:hover {
    transform: translateY(-2px);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero__media {
    position: relative;
    aspect-ratio: 9 / 10;
  }

  .hero__shape {
    position: absolute;
    top: 21%;
    bottom: 5%;
    left: -14%;
    right: calc(-1 * (var(--gutter) + max(0px, (100vw - var(--max-width)) / 2)));
    background-color: #c9d3ca;
    border-radius: 35% 0 0 0 / 65% 0 0 0;
    z-index: 0;
  }

  .hero__photo {
    position: absolute;
    z-index: 1;
    bottom: 5%;
    left: calc(50% + 2%);
    transform: translateX(-50%);
    height: 98%;
    width: auto;
    max-width: none;
    object-fit: contain;
    object-position: bottom center;
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__content {
      padding-top: 1rem;
    }

    .hero__media {
      order: -1;
      max-width: 420px;
      margin-inline: auto;
      width: 100%;
    }

    .hero__shape {
      left: -1rem;
      right: -1rem;
    }
  }

  @media (min-width: 641px) and (max-width: 1024px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
      gap: 1.5rem;
    }

    .hero__content {
      padding-top: clamp(5rem, 10vw, 7rem);
    }

    .hero__media {
      order: 0;
      max-width: none;
      margin-inline: 0;
      width: auto;
    }

    .hero__shape {
      left: -10%;
      right: calc(50% - 50vw);
    }

    .hero__actions .btn {
      font-size: 0.85rem;
      padding: 0.65rem 1.15rem;
    }

    .hero__actions {
      gap: 0.6rem;
    }

    .hero .eyebrow {
      font-size: 0.9rem;
      padding: 0.4rem 1rem 0.4rem 0.85rem;
      gap: 0.45rem;
    }

    .hero .eyebrow__dot {
      width: 9px;
      height: 9px;
    }
  }

  @media (min-width: 1201px) {
    .hero__content {
      padding-top: 6rem;
    }

    .hero__shape {
      top: 28%;
      left: -26%;
    }

    .hero__photo {
      left: calc(50% - 9%);
    }

    @media (max-height: 676px) {
      .hero__inner {
        padding-block-start: 1.5rem;
      }

      .hero__content {
        padding-top: 6rem;
      }
    }
  }

  @media (min-width: 1800px) {
    .hero__content {
      padding-top: 10rem;
    }
  }

  @media (max-width: 640px) {
    .hero__text {
      font-size: 1.05rem;
    }

    .hero__actions {
      width: 100%;
    }

    .hero__shape {
      top: 34%;
      left: 0;
      right: calc(50% - 50vw);
    }

    .hero__content .hero__title { order: 1; margin-bottom: 1.25rem; }
    .hero__content .eyebrow { order: 2; margin-bottom: 1.25rem; }
    .hero__content .hero__text { order: 3; }
    .hero__content .hero__actions { order: 4; }
  }
</style>
