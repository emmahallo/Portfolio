---
// Bilder für die Maus-Spur im Hero (verkleinerte Kopien in public/images/trail/)
const trailImages = Array.from({ length: 17 }, (_, i) => `/images/trail/trail-${String(i + 1).padStart(2, '0')}.jpg`);
---

<section class="hero" style="overflow-x: clip;">
  <div class="wrapper hero__inner">
    <div class="hero__content">
      <h1 class="hero__title">
        <span data-split="chars" style="--split-delay: 120ms">Hey, ich bin</span><br />
        <span class="hero__name">
          <span data-split="chars" style="--split-delay: 420ms">Emma Eichin!</span>
        </span>
      </h1>

      <p class="hero__text" data-reveal style="--reveal-delay: 700ms">
        Mit Fokus auf UI/UX gestalte ich Designs, die wirklich funktionieren –
        für Menschen, die es benutzen.
      </p>

      <div class="hero__actions" data-reveal style="--reveal-delay: 850ms">
        <div class="btn-shadow-wrap">
          <a href="/projekte" class="btn btn--primary">Zu meinen Projekten</a>
        </div>
        <div class="btn-shadow-wrap">
          <a href="/ueber-mich" class="btn btn--outline">Über mich</a>
        </div>
      </div>

    </div>

    <div class="hero__media">
      <div class="hero__media-parallax" data-parallax="0.06">
        <div class="hero__shape" aria-hidden="true"></div>
        <img
          class="hero__photo"
          src="/images/Portrait/emma.png"
          width="900"
          height="1000"
          alt="Porträtfoto von Emma Eichin"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding-block: clamp(2rem, 6vw, 4rem) var(--section-spacing);
  }

  .hero__content {
    position: relative;
    z-index: 3;
    padding-top: clamp(4rem, 9vw, 7rem);
    pointer-events: none;
  }

  /* Text bleibt „durchlässig“ für die Maus-Spur, Buttons bleiben klickbar */
  .hero__content a,
  .hero__content button {
    pointer-events: auto;
  }

  .hero__name {
    position: relative;
    display: inline-block;
  }

  .hero__star {
    position: absolute;
    top: -0.55em;
    right: -0.9em;
    width: 0.62em;
    height: 0.62em;
    background: var(--color-sage);
    -webkit-mask: url('/stern-3.svg') center / contain no-repeat;
    mask: url('/stern-3.svg') center / contain no-repeat;
    opacity: 0;
    animation:
      hero-star-pop 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) 1.1s forwards,
      hero-star-spin 14s linear 2s infinite;
  }

  @keyframes hero-star-pop {
    from { opacity: 0; scale: 0.2; }
    to { opacity: 1; scale: 1; }
  }

  @keyframes hero-star-spin {
    from { rotate: 0deg; }
    to { rotate: 360deg; }
  }

  .hero__hint {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2.25rem;
    font-family: 'Reenie Beanie', cursive;
    font-size: 1.6rem;
    line-height: 1;
    color: var(--color-sage-dark);
    transform: rotate(-3deg);
    opacity: 0;
    animation: hero-hint-in 0.8s ease 1.6s forwards;
    transition: opacity 0.6s ease;
  }

  .hero__hint-arrow {
    width: 44px;
    height: 30px;
    flex-shrink: 0;
  }

  .hero__hint-text--touch { display: none; }

  @media (hover: none) {
    .hero__hint-text--mouse { display: none; }
    .hero__hint-text--touch { display: inline; }
  }

  .hero.has-trailed .hero__hint {
    animation: none;
    opacity: 0;
  }

  @keyframes hero-hint-in {
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__hint { display: none; }
    .hero__star { opacity: 1; animation: none; }
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero__content .eyebrow {
    margin-bottom: 1.75rem;
  }

  .hero__title {
    margin-bottom: 1rem;
  }

  .hero__text {
    margin-bottom: 1.75rem;
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--color-ink);
    font-size: clamp(2.5rem, 5.2vw, 4rem);
    letter-spacing: 0.07em;
    line-height: 1.05;
  }

  .hero__text {
    font-weight: 300;
    font-size: 1.25rem;
    color: var(--color-text);
    max-width: 34ch;
  }

  .hero .eyebrow {
    font-size: 1rem;
  }

  .hero__actions .btn {
    font-size: 1.0625rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem;
  }

  .hero__actions .btn-shadow-wrap:last-child {
    margin-left: 0.5rem;
  }

  .btn-shadow-wrap {
    position: relative;
    display: inline-flex;
  }

  .btn-shadow-wrap::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(128, 149, 130, 0.35);
    transform: translate(-6px, 6px);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .btn-shadow-wrap:hover::before {
    transform: translate(-9px, 9px);
  }

  .btn-shadow-wrap .btn {
    position: relative;
    z-index: 1;
    transform: none !important;
    transition: background-color 0.35s ease, color 0.35s ease, border-color 0.35s ease, transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .btn-shadow-wrap .btn--outline {
    background: #ffffff;
  }

  .btn-shadow-wrap:hover .btn {
    transform: translateY(-2px) !important;
  }

  .hero__media {
    position: relative;
    aspect-ratio: 9 / 10;
  }

  .hero__media-parallax {
    position: absolute;
    inset: 0;
  }

  .hero__shape {
    position: absolute;
    top: 21%;
    bottom: 5%;
    left: -14%;
    right: calc(-1 * (var(--gutter) + max(0px, (100vw - var(--max-width)) / 2)));
    background-color: #c9d3ca;
    border-radius: 35% 0 0 0 / 65% 0 0 0;
    z-index: 0;
  }

  .hero__photo {
    position: absolute;
    z-index: 1;
    bottom: 5%;
    left: calc(50% + 2%);
    transform: translateX(-50%);
    height: 98%;
    width: auto;
    max-width: none;
    object-fit: contain;
    object-position: bottom center;
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__content {
      padding-top: 1rem;
    }

    .hero__media {
      order: -1;
      max-width: 420px;
      margin-inline: auto;
      width: 100%;
    }

    .hero__shape {
      left: -1rem;
      right: -1rem;
    }
  }

  @media (min-width: 641px) and (max-width: 1024px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
      gap: 1.5rem;
    }

    .hero__content {
      padding-top: clamp(5rem, 10vw, 7rem);
    }

    .hero__media {
      order: 0;
      max-width: none;
      margin-inline: 0;
      width: auto;
    }

    .hero__shape {
      left: -10%;
      right: calc(50% - 50vw);
    }

    .hero__actions .btn {
      font-size: 0.85rem;
      padding: 0.65rem 1.15rem;
    }

    .hero__actions {
      gap: 0.6rem;
    }

    .hero .eyebrow {
      font-size: 0.9rem;
      padding: 0.4rem 1rem 0.4rem 0.85rem;
      gap: 0.45rem;
    }

    .hero .eyebrow__dot {
      width: 9px;
      height: 9px;
    }
  }

  @media (min-width: 1201px) {
    .hero__content {
      padding-top: 6rem;
    }

    .hero__shape {
      top: 28%;
      left: -26%;
    }

    .hero__photo {
      left: calc(50% - 9%);
    }

    @media (max-height: 676px) {
      .hero__inner {
        padding-block-start: 1.5rem;
      }

      .hero__content {
        padding-top: 6rem;
      }
    }
  }

  @media (min-width: 1800px) {
    .hero__content {
      padding-top: 10rem;
    }
  }

  @media (max-width: 640px) {
    .hero__text {
      font-size: 1.05rem;
    }

    .hero__actions {
      width: 100%;
    }

    .hero__shape {
      top: 34%;
      left: 0;
      right: calc(50% - 50vw);
    }

    .hero__content .hero__title { order: 1; margin-bottom: 1.25rem; }
    .hero__content .eyebrow { order: 2; margin-bottom: 1.25rem; }
    .hero__content .hero__text { order: 3; }
    .hero__content .hero__actions { order: 4; }
    .hero__content .hero__hint { order: 5; margin-top: 1.5rem; font-size: 1.4rem; }
  }
</style>
