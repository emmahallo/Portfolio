---
import ProjectCard from './ProjectCard.astro';

interface Props {
  excludeHref?: string;
  heading?: string;
  id?: string;
}

const { excludeHref, heading = 'Meine Projekte', id = 'projekte' } = Astro.props;

const allProjects = [
  {
    title: 'Website für eine Ernährungsberaterin',
    meta: 'UI/UX Design | 2026',
    image: '/images/Vorschau%20Bilder/Website-Vorschau01.png',
    imagePosition: 'center 70%',
    href: '/projekte/website-ernährungsberatung',
  },
  {
    title: 'Website für ein imaginäres Hotel',
    meta: 'Webentwicklung 2 | 2026',
    image: '/images/Vorschau%20Bilder/Website-Vorschau02.png',
    imagePosition: 'center 70%',
    href: '/projekte/hotel-website',
  },
  {
    title: 'Website für ein imaginäres Surfcamp',
    meta: 'Webentwicklung 1 | 2026',
    image: '/images/Vorschau%20Bilder/Website-Vorschau03.png',
    imagePosition: 'center 70%',
    href: '/projekte/surfcamp',
  },
  {
    title: 'Activity Tracker',
    meta: 'UI/UX Design | 2024',
    image: '/images/Vorschau%20Bilder/Activity-Tracker.png',
    imagePosition: 'center 55%',
    href: '/projekte/activity-tracker',
  },
  {
    title: 'Projekte für das Kutter Gartencenter',
    meta: 'Kommunikationsdesign | seit 2021',
    image: '/images/Vorschau%20Bilder/Work_Voschau.png',
    href: '/projekte/kutter-gartencenter',
  },
  {
    title: 'Foto-Projekte',
    meta: 'Fotografie | seit 2024',
    image: '/images/Vorschau%20Bilder/DSC02545-Verbessert-RR%20Kopie.jpg',
    imagePosition: '20% center',
    href: '/projekte/foto-projekte',
  },
];

const projects = excludeHref ? allProjects.filter((p) => p.href !== excludeHref) : allProjects;
const dotCount = projects.length;
---

<section id={id} class="section projects">
  <div class="wrapper">
    <h2 class="section-heading" data-reveal>{heading}</h2>

    <div class="projects__carousel" data-reveal style="--reveal-delay: 80ms">
      <button type="button" class="projects__arrow projects__arrow--prev" data-dir="-1" aria-label="Vorheriges Projekt">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 18l-6-6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>

      <div class="projects__track" id="projects-track">
        {projects.map((project) => (
          <ProjectCard title={project.title} meta={project.meta} image={project.image} href={project.href} imagePosition={project.imagePosition} />
        ))}
      </div>

      <button type="button" class="projects__arrow projects__arrow--next" data-dir="1" aria-label="Nächstes Projekt">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 18l6-6-6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>

    <div class="projects__controls">
      <button type="button" class="projects__arrow projects__arrow--mobile projects__arrow--prev" data-dir="-1" aria-label="Vorheriges Projekt">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 18l-6-6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="projects__dots" id="projects-dots" aria-hidden="true">
        {Array.from({ length: dotCount }).map((_, i) => <span class="projects__dot" data-index={i}></span>)}
      </div>
      <button type="button" class="projects__arrow projects__arrow--mobile projects__arrow--next" data-dir="1" aria-label="Nächstes Projekt">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 18l6-6-6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  </div>
</section>

<script>
  const track = document.getElementById('projects-track');
  const dotsWrap = document.getElementById('projects-dots');
  if (track && dotsWrap) {
    const originals = Array.from(track.children) as HTMLElement[];
    const dots = Array.from(dotsWrap.children) as HTMLElement[];
    const visibleCount = 3;
    const total = originals.length;

    const startClones = originals.slice(-visibleCount).map((c) => c.cloneNode(true) as HTMLElement);
    const endClones = originals.slice(0, visibleCount).map((c) => c.cloneNode(true) as HTMLElement);
    for (let i = startClones.length - 1; i >= 0; i--) track.insertBefore(startClones[i], track.firstChild);
    endClones.forEach((clone) => track.appendChild(clone));

    const cards = Array.from(track.children) as HTMLElement[];
    const firstOriginal = visibleCount;
    let position = firstOriginal;
    let isAnimating = false;

    const ANIMATION_DURATION = 650;
    const easeInOutCubic = (t) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

    let rafId = 0;
    const scrollToPosition = (p, animate) => {
      const target = cards[p];
      if (!target) return;
      const to = target.offsetLeft;
      if (rafId) cancelAnimationFrame(rafId);
      if (!animate) {
        track.scrollLeft = to;
        return;
      }
      const from = track.scrollLeft;
      const distance = to - from;
      if (distance === 0) return;
      const prevSnap = track.style.scrollSnapType;
      track.style.scrollSnapType = 'none';
      const startTime = performance.now();
      const step = (now) => {
        const elapsed = now - startTime;
        const t = Math.min(elapsed / ANIMATION_DURATION, 1);
        track.scrollLeft = from + distance * easeInOutCubic(t);
        if (t < 1) {
          rafId = requestAnimationFrame(step);
        } else {
          rafId = 0;
          track.style.scrollSnapType = prevSnap;
        }
      };
      rafId = requestAnimationFrame(step);
    };

    const updateDots = () => {
      const originalIdx = ((position - firstOriginal) % total + total) % total;
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === originalIdx));
    };

    const goTo = (newPosition: number) => {
      if (isAnimating) return;
      isAnimating = true;
      position = newPosition;
      scrollToPosition(position, true);
      updateDots();

      window.setTimeout(() => {
        if (position >= firstOriginal + total) {
          position -= total;
          scrollToPosition(position, false);
        } else if (position < firstOriginal) {
          position += total;
          scrollToPosition(position, false);
        }
        isAnimating = false;
      }, ANIMATION_DURATION + 40);
    };

    document.querySelectorAll<HTMLButtonElement>('.projects__arrow').forEach((btn) => {
      btn.addEventListener('click', () => {
        const dir = Number(btn.dataset.dir ?? '1');
        goTo(position + dir);
      });
    });

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        goTo(firstOriginal + i);
      });
    });

    requestAnimationFrame(() => {
      scrollToPosition(firstOriginal, false);
      updateDots();
    });
  }
</script>

<style>
  .projects__carousel {
    position: relative;
  }

  .projects__arrow {
    position: absolute;
    top: 40%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: var(--color-sage);
    color: #ffffff;
    border: none;
    cursor: pointer;
    z-index: 2;
    transition: background-color 0.2s ease;
  }

  .projects__arrow:hover {
    background: var(--color-ink);
  }

  .projects__arrow--prev {
    left: -22px;
  }

  .projects__arrow--next {
    right: -22px;
  }

  .projects__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 2rem) / 3);
    gap: 1rem;
    overflow-x: auto;
    overflow-y: visible;
    scrollbar-width: none;
    scroll-behavior: auto;
    padding-block: 14px 32px;
    margin-block: -14px -32px;
  }

  .projects__track::-webkit-scrollbar {
    display: none;
  }

  .projects__dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.75rem;
  }

  .projects__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-sage-tint);
    cursor: pointer;
    border: none;
    padding: 0;
  }

  .projects__dot.is-active {
    background: var(--color-sage);
  }

  .projects__controls {
    display: none;
  }

  @media (max-width: 900px) {
    .projects__track {
      grid-auto-columns: 80%;
    }

    .projects__arrow--prev { left: 4px; }
    .projects__arrow--next { right: 4px; }
  }

  @media (min-width: 641px) and (max-width: 1200px) {
    .projects__carousel .projects__arrow {
      display: none;
    }

    .projects__track {
      grid-auto-columns: calc((100% - 1rem) / 2);
      scroll-snap-type: x mandatory;
    }

    .projects__track > :global(*) {
      scroll-snap-align: start;
    }

    .projects__track :global(.project-card__title) {
      white-space: normal;
      overflow-wrap: anywhere;
      word-break: normal;
      hyphens: auto;
    }

    .projects__track :global(.project-card__meta-row) {
      flex-wrap: wrap;
      row-gap: 0.25rem;
    }

    .projects__track :global(.project-card__meta) {
      white-space: normal;
      overflow-wrap: anywhere;
    }

    .projects__controls {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      margin-top: 1.5rem;
    }

    .projects__arrow--mobile {
      position: static;
      transform: none;
      width: 40px;
      height: 40px;
      flex: 0 0 auto;
      background: var(--color-sage);
      border-radius: 0;
    }

    .projects__dots {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 0;
    }
  }

  @media (max-width: 640px) {
    .projects__carousel .projects__arrow {
      display: none;
    }

    .projects__track {
      grid-auto-columns: 100%;
      gap: 0.75rem;
      scroll-snap-type: x mandatory;
      padding-block: 8px 20px;
      margin-block: -8px -20px;
    }

    .projects__track > * {
      scroll-snap-align: center;
    }

    .projects__controls {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      margin-top: 1.5rem;
    }

    .projects__arrow--mobile {
      position: static;
      transform: none;
      width: 40px;
      height: 40px;
      flex: 0 0 auto;
      background: var(--color-sage);
      border-radius: 0;
    }

    .projects__dots {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 0;
    }
  }
</style>
